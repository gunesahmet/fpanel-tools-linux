#!/bin/bash

# chkconfig: 2345 90 10
# description: ProFTP Server

### BEGIN INIT INFO
# Provides:          proftpd
# Required-Start:    $remote_fs $syslog $local_fs $network
# Required-Stop:     $remote_fs $syslog $local_fs $network
# Should-Start:      $named
# Should-Stop:       $named
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Starts ProFTPD daemon
# Description:       This script runs the FTP service offered
#                    by the ProFTPD daemon
### END INIT INFO

BINDIR="/usr/sbin"

DAEMON="proftpd"
PARAM=""
PROG="ProFTP Server"

[ -f /etc/init.d/functions ] && . /etc/init.d/functions

function check_daemon() {

	export PATH="$PATH:$BINDIR"

	if [ ! -x $BINDIR/$DAEMON ]
		then
			echo "Error: can't executable $DAEMON"
			exit 0
	fi

	PID=`pidof $DAEMON`

}

function start() {

	check_daemon

	if [ "$PID" = "" ]
		then
			echo -n "Starting $PROG:"
			$DAEMON $PARAM 2>/dev/null
			echo 
		else
			echo "$PROG (pid $PID) is running..."
	fi
	
}

function stop() {

	check_daemon

	if [ "$PID" != "" ]
		then
			echo -n "Stopping $PROG:"
			kill $PID >/dev/null 2>&1
			echo 
		else
			echo "$PROG is stopped"
	fi
	
}

function reload() {
	echo "Reloading $PROG.."
	stop >/dev/null 2>&1
	sleep 0.25
	start >/dev/null 2>&1
}

function status() {

	check_daemon

	if [ "$PID" = "" ]
		then
			echo "$PROG is stopped"
		else
			echo "$PROG (pid $PID) is running..."
	fi
	
}


#
# main()
#

case "${1:-''}" in
  'start')
	start
	;;

  'stop')
	stop
	;;

  'reload'|'restart')
	reload
  	;;

  'status')
	status
	exit 0
  	;;

  *)
	echo "Usage: $0 {start|stop|reload|status}"
	echo ""
	exit 1
	;;
esac
