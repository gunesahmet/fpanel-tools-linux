#!/bin/bash
# Encrypted by FPanel-Compiler

function check_root() {
	if [ $(id -u) -ne 0 ]; then

              echo "Error 1001: You must be root"
              exit 1
	fi
}

function detect_system_type() {
       if [ -f "/etc/os-release" ]; then
              OS_RELEASE_FILE=`cat /etc/os-release | grep "^ID="`
              echo $OS_RELEASE_FILE | sed -e 's/ID=//g' -e 's/"//g'
       else
              LSB_RELEASE=`lsb_release -is`
              echo "$LSB_RELEASE" | tr '[:upper:]' '[:lower:]'
       fi
}

function detect_system_version() {
       if [ -f "/etc/os-release" ]; then
              OS_RELEASE_FILE=`cat /etc/os-release | grep "^VERSION_ID=" | sed -e 's/\"//g'  -e "s/\'//g"`
              echo $OS_RELEASE_FILE | sed -e 's/VERSION_ID=//g' -e 's/"//g'  -e "s/\'//g"
       else
              LSB_RELEASE=`lsb_release -rs`
              echo "$LSB_RELEASE" | tr '[:upper:]' '[:lower:]' | sed -e 's/\./ /g' -e "s/\'//g" | awk '{print $1}'
       fi
}

function detect_system_detailed() {
       if [ -f "/etc/os-release" ]; then
              OS_RELEASE_FILE=`cat /etc/os-release | grep "^PRETTY_NAME=" | sed -e 's/\"//g' -e 's/ /-/g' -e "s/\'//g"`
              echo $OS_RELEASE_FILE | sed -e 's/PRETTY_NAME=//g'
       else
              LSB_RELEASE=`lsb_release -d | sed -e 's/Description\://g'`
              echo "$LSB_RELEASE" | sed -e 's/\./ /g' | awk '{print $1}'
       fi
}

