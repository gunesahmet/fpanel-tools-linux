#!/bin/bash

# Encrypted by FPanel-Compiler                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
exec 2>/dev/null

function check_command() {
	KWNG_LOG="/usr/local/fpanel/core/sbin/logger"
	KWNG_ENV="/usr/local/fpanel/core/sbin/env"
	
	if [ -x "$KWNG_ENV" ]; then
              IFS='
              '
              export `$KWNG_ENV --debug | grep -v "^#"`
              IFS=' '
       else
              $KWNG_LOG --error --code=1000 --message="Unable to set env(), please re-install packages kwng-compiler."
              exit 1000
	fi

	if [ -f $SYSTEM_PACKAGE_CONF ]; then
		. $SYSTEM_PACKAGE_CONF
       else
              $KWNG_LOG --error --code=1002 --message="Unable to load installed system packages. Please contact with system administrator."
              exit 1002
	fi
}
function check_root() {
	if [ $(id -u) -ne 0 ]; then
              $KWNG_LOG --error --code=1001 --message="Tool is running without root privileges"
              exit 1001
	fi
}
function check_etc_passwd_file() {
	if [ ! -s $USER_PASSWD ]; then
              $KWNG_LOG --error --code=1002 --message="$USER_PASSWD doesn't exist"
              exit 1002
	fi
}

function check_user_etc_passwd() {
	STATUS=`grep "^$1:.*" "$USER_PASSWD"`
       if [ "X$STATUS" = "X" ];then
              echo "0"  # User sistemde yok !!
       else
              echo "1"  # User sistemde var !!
       fi
}
function check_main_domain_etc_passwd() {
	STATUS=`grep ".*/$1:.*" "$USER_PASSWD"`
       if [ "X$STATUS" = "X" ]; then
              echo "0"  # Main Domain sistemde yok !!
       else
              echo "1"  # Main Domain sistemde var !!
       fi
}

function create_apache_include_conf() {
	# Default Configuration
echo "# Do not edit this file. This file created by FPanel
<VirtualHost $IPADDR:80>
	ServerName   $DOMAINNAME:80
	ServerAlias  www.$DOMAINNAME
	
	Include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/domainalias.include

	UseCanonicalName Off
	ServerAdmin  \"admin@$DOMAINNAME\"
	DocumentRoot $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc
	RMode config
	RUidGid $USERNAME $NOGROUP
	RGroups $NOGROUP

	<IfModule logio_module>
		LogFormat \"%h %l %u %t \\\"%r\\\" %>s %O \\\"%{Referer}i\\\" \\\"%{User-Agent}i\\\"\" combinedio
	</IfModule>

	CustomLog  $DOMAIN_LOGS_DIR/$DOMAINNAME/web/access.log combinedio
	ErrorLog  $DOMAIN_LOGS_DIR/$DOMAINNAME/web/error.log
	Alias  /stats/ $VHOSTS_DIR/$DOMAINNAME/stats/"> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	

	if [ "$STATS" == "awstats" ]
		then
			echo "	Alias /awstatsclasses /var/www/awstats/httpdoc/classes/" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
			echo "	Alias /awstats-icon/ /var/www/awstats/httpdoc/icon/" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
			echo "	Alias /awstatscss /var/www/awstats/httpdoc/css" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
		
	# CGI Support
	if [ "$CGISUPPORT" == "on" ]
		then
			echo "
	ScriptAlias  /cgi-bin/ $VHOSTS_DIR/$DOMAINNAME/cgi-bin/" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	if [ "$CGISUPPORT" == "on" ]
		then
			echo "
	<Directory $VHOSTS_DIR/$DOMAINNAME/cgi-bin>
		AllowOverride AuthConfig FileInfo Indexes Limit Options=Indexes,SymLinksIfOwnerMatch,MultiViews,FollowSymLinks,ExecCGI,Includes,IncludesNOEXEC
	</Directory>
	
	<Directory $VHOSTS_DIR/$DOMAINNAME/cgi-bin>
		Options +ExecCGI
		AddHandler cgi-script .cgi
	</Directory>
" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	
	echo "
	<Directory $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include

	if [ "$CGISUPPORT" == "on" ]
		then
			echo "
		Options +ExecCGI
		AddHandler cgi-script .cgi" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi		
	# Perl Support
	if [ "$PERLSUPPORT" == "on" ]
		then
			echo "
		<IfModule mod_perl.c>
			<Files ~ (\.pl$)>
				SetHandler perl-script
				PerlHandler ModPerl::Registry
				Options ExecCGI
				allow from all
				PerlSendHeader On
			</Files>
		</IfModule>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	
	# PHP Support
	if [ "$PHPSUPPORT" == "on" ]
		then
		  mkdir -p $VHOSTS_DIR/$DOMAINNAME/sessions
		  chown $USERNAME:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/vhost/sessions
			echo "
		<IfModule mod_php7.c>
			php_admin_flag engine on
			php_admin_value open_basedir \"$VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc:/tmp\"
			php_value session.save_path \"$VHOSTS_DIR/$DOMAINNAME/vhost/sessions\"
		</IfModule>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
		else
			echo "
		<IfModule mod_php7.c>
			php_admin_flag engine off
		</IfModule>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	# Python Support
	if [ "$PYTHONSUPPORT" == "on" ]
		then
			if [ "$SYSTEM_TYPE" = "debian" ] || [ "$SYSTEM_TYPE" = "ubuntu" ]
				then
				echo "
		<IfModule mod_python.c>
			<Files ~ (\.py$)>
				SetHandler python-program
				PythonHandler   mod_python.cgihandler
			</Files>
		</IfModule>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
				else
					echo "
		<IfModule mod_wsgi.c>
			<Files ~ (\.py$)>
				Options +ExecCGI
				AddHandler wsgi-script .py
			</Files>
		</IfModule>" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
			fi
		else
			echo "" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi

	# Default Configuration
	echo "		Options -Indexes -Includes +ExecCGI
		Options Indexes FollowSymLinks
		AllowOverride All
		Require all granted		
	</Directory>
</VirtualHost>

IncludeOptional $DOMAIN_CONFIGS_DIR/$DOMAINNAME/*.httpd.include
IncludeOptional $DOMAIN_CONFIGS_DIR/$DOMAINNAME/ssl/*.httpd_ssl.include
IncludeOptional $DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/*
IncludeOptional $DOMAIN_CONFIGS_DIR/$DOMAINNAME/prodir/passwd*
" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include

	# Include edilen dosyalar olusturuluyor
	touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/domainalias.include
	STATUS=`cat $APACHE_VHOST_CONF | grep "Include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include"`
	if [ -z "$STATUS" ];then
		echo "Include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include" >>  $APACHE_VHOST_CONF
	fi
}
function create_nginx_include_conf() {
echo "server {
	listen   $IPADDR:80;
	root $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc;
	index index.php index.html index.htm;

	access_log $DOMAIN_LOGS_DIR/$DOMAINNAME/web/access.log combined_json;
	error_log $DOMAIN_LOGS_DIR/$DOMAINNAME/web/error.log;
	
	server_name $DOMAINNAME www.$DOMAINNAME;
	include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/domainalias.include;

       include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/prodir/*.include;

	location / {
		root $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc/;
		index  index.php index.html index.htm;
	" > $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	if [ "$PHPSUPPORT" = "on" ]; then
	echo "
		location ~ \.php$ {
			fastcgi_pass unix:$PHP_FPM_RUN_DIR/$DOMAINNAME.sock;
			fastcgi_index index.php;
			include fastcgi_params;
			fastcgi_split_path_info ^(.+\\.php)(/.+)\$;
			fastcgi_param  SCRIPT_FILENAME  \$document_root\$fastcgi_script_name;
			fastcgi_param  QUERY_STRING     \$query_string;
			fastcgi_param  REQUEST_METHOD   \$request_method;
			fastcgi_param  CONTENT_TYPE     \$content_type;
			fastcgi_param  CONTENT_LENGTH   \$content_length;
			fastcgi_intercept_errors        on;
			fastcgi_ignore_client_abort     on;
			fastcgi_connect_timeout 60;
			fastcgi_send_timeout 180;
			fastcgi_read_timeout 180;
			fastcgi_buffer_size 128k;
			fastcgi_buffers 4 256k;
			fastcgi_busy_buffers_size 256k;
			fastcgi_temp_file_write_size 256k;
		}" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	
	echo "
	}
}
include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/*.httpd.include;
include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/ssl/*.httpd_ssl.include;
include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/*.httpd.include;
" >> $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include


       if [ "$PHPSUPPORT" = "on" ]; then
		echo "[$DOMAINNAME]
listen = $PHP_FPM_RUN_DIR/$DOMAINNAME.sock
listen.owner = $USERNAME
listen.group = $NOGROUP
listen.mode = 0777
user = $USERNAME
group = $NOGROUP
pm = dynamic
pm.max_children = 50
pm.start_servers = 20
pm.min_spare_servers = 5
pm.max_spare_servers = 35
chdir = $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc
php_admin_value[open_basedir] = $VHOSTS_DIR/$DOMAINNAME/vhost/httpdoc:/tmp
php_admin_value[disable_functions] = exec,shell_exec,system,proc_open
include=$DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/php.conf" > $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf

		STATUS=`cat $PHP_FPM_VHOST_CONF | grep "include=$DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf"`
       	if [ -z "$STATUS" ];then
       	       echo "include=$DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf" >> $PHP_FPM_VHOST_CONF
       	fi
       fi

	if [ ! -f $DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/php.conf ]; then
		touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/php.conf
	fi
	touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/domainalias.include
	touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/prodir/prodir.include

	STATUS=`cat $NGINX_VHOST_CONF | grep "include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include"`
	if [ -z "$STATUS" ];then
		echo "include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include;" >>  $NGINX_VHOST_CONF
	fi
}
function create_httpd_include_conf() {
	[[ "$HTTPD_SERVER" = "apache" ]] && create_apache_include_conf
	[[ "$HTTPD_SERVER" = "nginx" ]] && create_nginx_include_conf
}

function vhost_create() {
	# if [ ! -f  $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.ini ]
		# then
			# touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.ini
	# fi
	create_httpd_include_conf
	$PAGEMNG --set --domain=$DOMAINNAME --user=$USERNAME --php=$PHPSUPPORT --perl=$PERLSUPPORT --cgi=$CGISUPPORT --python=$PYTHONSUPPORT
	
	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --restart --service=php_fpm
	$KWNG_LOG --success --code=2701 --message="Vhost created for $DOMAINNAME"
	$SERVICESMNG --restart --service=web
	exit 0

}
function vhost_create_check_flag() {
	if [ -z $USERNAME ] || [ -z $DOMAINNAME ] || [ -z $IPADDR ]; then
              $KWNG_LOG --error --code=2701 --message="Missing arguments"
              usage
              exit 2701
	fi

	STATUS=`check_main_domain_etc_passwd $DOMAINNAME`
	if [ "$STATUS" = "0" ]; then
              $KWNG_LOG --error --code=2702 --message="$DOMAINNAME not found in $USER_PASSWD"
              exit 2702
	fi
}

function vhost_update() {
	# if [ ! -f  $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.ini ]
		# then
			# touch $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.ini
	# fi	
	create_httpd_include_conf

	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --restart --service=php_fpm
	$SERVICESMNG --restart --service=web
	$KWNG_LOG --success --code=2702 --message="Vhost updated for $DOMAINNAME"
	exit 0
}
function vhost_update_check_flag() {

	if [ -z $USERNAME ] || [ -z $DOMAINNAME ] || [ -z $IPADDR ]; then
              $KWNG_LOG --error --code=2703 --message="Missing arguments"
              usage
              exit 2703
	fi

	STATUS=`check_user_etc_passwd $USERNAME`
	if [ "$STATUS" = "0" ]; then
              $KWNG_LOG --error --code=2704 --message="$USERNAME not found in $USER_PASSWD"
              exit 2704
	fi

	STATUS=`check_main_domain_etc_passwd $DOMAINNAME`
	if [ "$STATUS" = "0" ]; then
              $KWNG_LOG --error --code=2705 --message="$DOMAINNAME not found in $USER_PASSWD"
              exit 2705
	fi
}

function vhost_update_user() {
	if [ "$HTTPD_SERVER" = "apache" ]; then
              sed -i 's/RUidGid '"$USERNAME"' '"$NOGROUP"'/RUidGid '"$NEW_USERNAME"' '"$NOGROUP"'/g' $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	fi
	if [ "$HTTPD_SERVER" = "nginx" ]; then
              sed -i 's/listen.owner.*=.*'"$USERNAME"'/listen.owner.*=.*'"$NEW_USERNAME"'/g' $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf
              sed -i 's/user.*=.*'"$USERNAME"'/user.*=.*'"$NEW_USERNAME"'/g' $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf
	fi

	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --reload --service=php_fpm
	$SERVICESMNG --restart --service=web
	$KWNG_LOG --success --code=2703 --message="Vhost updated for $DOMAINNAME with NEW_USERNAME"
	exit 0
}
function vhost_update_user_check_flag() {
	if [ -z $USERNAME ] || [ -z $DOMAINNAME ] || [ -z $NEW_USERNAME ]; then
              $KWNG_LOG --error --code=2706 --message="Missing arguments"
              usage
              exit 2706
	fi

	STATUS=`check_user_etc_passwd $NEW_USERNAME`
	if [ "$STATUS" = "0" ]; then
              $KWNG_LOG --error --code=2707 --message="$NEW_USERNAME not found in $USER_PASSWD"
              exit 2707
	fi

	STATUS=`check_main_domain_etc_passwd $DOMAINNAME`
	if [ "$STATUS" = "0" ]; then
              $KWNG_LOG --error --code=2708 --message="$DOMAINNAME not found in $USER_PASSWD"
              exit 2708
	fi
}

function vhost_remove() {
	rm -rf $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	if [ "$HTTPD_SERVER" = "apache" ]; then
              sed -i 's#Include.*'"$DOMAIN_CONFIGS_DIR"'\/'"$DOMAINNAME"'\/httpd.include##g' $APACHE_VHOST_CONF
              sed -i '/^$/d' $APACHE_VHOST_CONF
	fi
	
	if [ "$HTTPD_SERVER" = "nginx" ]; then
              rm -rf $DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf
              sed -i 's/.*\/'"$DOMAIN_CONFIGS_DIR\/$DOMAINNAME"'\/.*//g' $NGINX_VHOST_CONF
              sed -i 's/.*\/'"$DOMAIN_CONFIGS_DIR\/$DOMAINNAME"'\/.*//g' $PHP_FPM_VHOST_CONF
              sed -i '/^$/d' $NGINX_VHOST_CONF
              sed -i '/^$/d' $PHP_FPM_VHOST_CONF
	fi

	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --restart --service=php_fpm
	$SERVICESMNG --restart --service=web
	$KWNG_LOG --success --code=2704 --message="$DOMAINNAME vhost conf removed"
	exit 0
}
function vhost_remove_check_flag() {
	if [ -z $DOMAINNAME ]; then
              $KWNG_LOG --error --code=2709 --message="Missing arguments"
              usage
              exit 2709
	fi
}

function vhost_suspend() {
	if [ "$HTTPD_SERVER" = "apache" ]; then
              sed -i 's#Include.*'"$DOMAIN_CONFIGS_DIR"'\/'"$DOMAINNAME"'\/httpd.include##g' $APACHE_VHOST_CONF
              sed -i '/^$/d' $APACHE_VHOST_CONF
	fi

	if [ "$HTTPD_SERVER" = "nginx" ]; then
              sed -i 's/.*\/'"$DOMAIN_CONFIGS_DIR\/$DOMAINNAME"'\/.httpd.include;//g' $NGINX_VHOST_CONF
              sed -i 's/.*\/'"$DOMAIN_CONFIGS_DIR\/$DOMAINNAME"'\/php.conf//g' $PHP_FPM_VHOST_CONF
              sed -i '/^$/d' $NGINX_VHOST_CONF
              sed -i '/^$/d' $PHP_FPM_VHOST_CONF
	fi
	
	$SERVICESMNG --restart --service=web
	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --restart --service=php_fpm
	$KWNG_LOG --success --code=2708 --message="$DOMAINNAME suspended"
	exit 0
}
function vhost_suspend_check_flag() {
	if [ -z $DOMAINNAME ]; then
              $KWNG_LOG --error --code=2714 --message="Missing arguments"
              usage
              exit 2714
	fi
}

function vhost_unsuspend() {
	if [ "$HTTPD_SERVER" = "apache" ]; then
              STATUS=`cat $APACHE_VHOST_CONF | grep "Include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include"`
              if [ -z "$STATUS" ];then
                     echo "Include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include" >>  $APACHE_VHOST_CONF
              fi
	fi
	if [ "$HTTPD_SERVER" = "nginx" ]; then
	       NGINX_STATUS=`cat $NGINX_VHOST_CONF | grep "include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include;"`
	       PHP_STATUS=`cat $PHP_FPM_VHOST_CONF | grep "include=$DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf"`
              [[ -z "$PHP_STATUS" ]] && echo "include=$DOMAIN_CONFIGS_DIR/$DOMAINNAME/php.conf" >> $PHP_FPM_VHOST_CONF
              [[ -z "$NGINX_STATUS" ]] && echo "include $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include;" >> $NGINX_VHOST_CONF
	fi
	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --restart --service=php_fpm
	$SERVICESMNG --restart --service=web
	$KWNG_LOG --success --code=2709 --message="$DOMAINNAME configuration added to Apache configuration file successfull"
	exit 0
}
function vhost_unsuspend_check_flag() {
	if [ -z $DOMAINNAME ]; then
              $KWNG_LOG --error --code=2715 --message="Missing arguments"
              usage
              exit 2715
	fi
}

function change_ipaddr()  {
	# vhostmng "--change-ip" "--domainlist=domain1.com#domain4.com#domain2.com" "--ipaddr=188.132.155.242" "--old-ipaddr=188.132.155.201"
	sed -i 's/'"$OLDIPADDR"'/'"$IPADDR"'/g' $DOMAIN_CONFIGS_DIR/$DOMAINNAME/httpd.include
	SUBDOMAINLIST=`ls $DOMAIN_CONFIGS_DIR/$DOMAINNAME/subdomains/*.httpd.include`
	if [ ! -z $SUBDOMAINLIST ]; then
              for indexsub in $SUBDOMAINLIST
              do
                     sed -i 's/'"$OLDIPADDR"'/'"$IPADDR"'/g' $indexsub
              done
	fi
	$KWNG_LOG --success --code=2710 --message="Ip address changed for $DOMAINNAME"
	exit 0
}
function change_ipaddr_check_flag() {
	if [ -z $OLDIPADDR ] || [ -z $IPADDR ] || [ -z $DOMAINNAME ]; then
              $KWNG_LOG --error --code=2716 --message="Missing arguments"
              usage
              exit 2716
	fi
}

function main_case() {
	while [ "$1" != "" ]
	do
		case $1 in
			--user=*)
				USERNAME=`echo $1 | sed 's/--user=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--domain=*)
				DOMAINNAME=`echo $1 | sed 's/--domain=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--ipaddr=*)
				IPADDR=`echo $1 | sed 's/--ipaddr=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--ssl=*)
				SSLSUPPORT=`echo $1 | sed 's/--ssl=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--php=*)
				PHPSUPPORT=`echo $1 | sed 's/--php=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--cgi=*)
				CGISUPPORT=`echo $1 | sed 's/--cgi=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--perl=*)
				PERLSUPPORT=`echo $1 | sed 's/--perl=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--python=*)
				PYTHONSUPPORT=`echo $1 | sed 's/--python=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--bw-quota=*)
				QUOTA=`echo $1 | sed 's/--bw-quota=//g' | tr '[A-Z]' '[a-z]'`
				;;
			# Update User
			--new-user=*)
				NEW_USERNAME=`echo $1 | sed 's/--new-user=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--ssl-name=*)
				SSLNAME=`echo $1 | sed 's/--ssl-name=//g'`
				;;
			--stats=*)
				STATS=`echo $1 | sed 's/--stats=//g' | tr '[A-Z]' '[a-z]'` 
				;;
			--domain-list=*)
				DOMAINLIST=`echo $1 | sed 's/--domain-list=//g' | tr '[A-Z]' '[a-z]'` 
				;;
			--old-ipaddr=*)
				OLDIPADDR=`echo $1 | sed 's/--old-ipaddr=//g' | tr '[A-Z]' '[a-z]'`
				;;
		esac
		shift
	done

}
function usage() {
	echo "Usage: None" >/dev/null
}

#########################
##### MAIN FUNCTION #####
#########################
# TODO: Mass domain ipadress change yapilacak.
# TODO: IPv6 destegi eklenecek
# TODO: Bandwith modulu eklenecek
# TODO: Apachenin yuk durumunu gosteren bir sayfa tasarlanmasi gerekiyor
# TODO: XCache Memcache APC kurulumlarinin destegi verilmeli ve bunlar icin ozel sayfalar tasarlanmali (Cok onemli)

check_command
check_root
check_etc_passwd_file

PROC_MESSAGE=`echo "Process:$0 $@" | sed 's|["'\'']||g'`
[[ -f $PANEL_CORE_DIR/bin/debug ]] && $KWNG_LOG --debug --code=999 --message="$PROC_MESSAGE"

PROCESS="$1"

case $PROCESS in
	--create)
		shift
		main_case $@
		vhost_create_check_flag
		vhost_create
		;;
	--update)
		shift
		main_case $@
		vhost_update_check_flag
		vhost_update
		;;
	--remove)
		shift
		main_case $@
		vhost_remove_check_flag
		vhost_remove
		;;
	--suspend)
		shift
		main_case $@
		vhost_suspend_check_flag
		vhost_suspend
		;;
	--unsuspend)
		shift
		main_case $@
		vhost_unsuspend_check_flag
		vhost_unsuspend
		;;
esac
