function init_logs() {
	if [ -z "$DOMAINNAME" ]; then
		$KWNG_LOG --error --code=7901 --message="Missing arguments"
		exit 7901
	fi
	# DOMAIN_DIRECTORY="$VHOSTS_DIR/$DOMAINNAME"
	# echo "$CONFIG" > "$DOMAIN_DIRECTORY/stats/web-stats/statistics.cfg"
	
	[[ "$STATISTICS" = "awstats" ]] && $AWSTATS --init-domain --domain=$DOMAINNAME
	[[ "$STATISTICS" = "webalizer" ]] && $WEBALIZERMNG --init-domain --domain=$DOMAINNAME
	# default_conf	
	# Eski statistics
	# $WEB_STATISTICS_TOOL -G +g"$DOMAIN_DIRECTORY/stats/web-stats/statistics.cfg"
	# $PANEL_HTTP_DIR/php/bin/php $WEB_STATISTICS_CLI "Statistics" "logparse" $DOMAINNAME
	$KWNG_LOG --success --code=7201 --message="Statistics calculated for $DOMAINNAME"
}

function get_report_check_flags() {
	if [ -z "$DOMAINNAME" ]; then
		$KWNG_LOG --error --code=7902 --message="Missing arguments"
		exit 7902
	fi
}
function get_report() {
	cat $VHOSTS_DIR/$DOMAINNAME/stats/web-stats/report.json
}

check_command
check_root

PROC_MESSAGE=`echo "Process:$0 $@" | sed 's|["'\'']||g'`
[[ -f $PANEL_CORE_DIR/bin/debug ]] && $KWNG_LOG --debug --code=999 --message="$PROC_MESSAGE"

case $1 in
	--init)
		shift
		main_case $@
		init_logs
		exit 0
		;;
	--get-report)
		shift
		main_case $@
		get_report
		exit 0
		;;
esac
