}

function mail_addr_alias_create_check_flag() {
	if [ -z $MAIL_ADDR ] || [ -z $MAIL_ALIAS ]; then
		$KWNG_LOG --error --code=1736 --message="Missing arguments"
		exit 1736
	fi

	DOMAINNAME=$(echo $MAIL_ADDR | awk -F'@' '{print $2}')
	MAIL_ADDR=$(echo $MAIL_ADDR | awk -F'@' '{print $1}')
	MAIL_ALIAS=$(echo $MAIL_ALIAS | awk -F'@' '{print $1}')

	check_domain >/dev/null
	if [ -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1737 --message="$DOMAINNAME not found"
		exit 1737
	fi

	check_mail_addr # >/dev/null
	if [ -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1738 --message="$MAIL_ADDR@$DOMAINNAME not found"
		exit 1738
	fi

	check_mail_alias # >/dev/null
	if [ ! -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1739 --message="$MAIL_ALIAS@$DOMAINNAME exists"
		exit 1739
	fi
}
function mail_addr_alias_create() {
	$SQLITE $MAIL_DB "insert into alias values(NULL,'$DOMAINNAME','$MAIL_ALIAS@$DOMAINNAME','$MAIL_ADDR@$DOMAINNAME','virtual','1');"
	$KWNG_LOG --success --code=1716 --message="$MAIL_ALIAS added for alias to $MAIL_ADDR"
	exit 0
}

function mail_addr_alias_remove_check_flag() {
	if [ -z $MAIL_ADDR ] || [ -z $MAIL_ALIAS ]; then
		$KWNG_LOG --error --code=1740 --message="Missing arguments"
		exit 1740
	fi

	DOMAINNAME=$(echo $MAIL_ADDR | awk -F'@' '{print $2}')
	MAIL_ADDR=$(echo $MAIL_ADDR | awk -F'@' '{print $1}')
	MAIL_ALIAS=$(echo $MAIL_ALIAS | awk -F'@' '{print $1}')

	check_mail_alias >/dev/null
	if [ -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1741 --message="$MAIL_ALIAS not found"
		exit 1741
	fi
}
function mail_addr_alias_remove() {
	$SQLITE $MAIL_DB "delete from alias where mailaddr='$MAIL_ALIAS@$DOMAINNAME';"
	$KWNG_LOG --success --code=1717 --message="$MAIL_ALIAS added for alias to $MAIL_ADDR"
	exit 0
}

# Kontrol edilecek
function mail_addr_forward_create_check_flag() {
	if [ -z "$MAIL_ADDR" ] || [ -z "$MAIL_FORWARD" ]; then
		$KWNG_LOG --error --code=1742 --message="Missing arguments"
		exit 1742
	fi

	DOMAINNAME=$(echo $MAIL_ADDR | awk -F'@' '{print $2}')
	MAIL_ADDR=$(echo $MAIL_ADDR | awk -F'@' '{print $1}')

	check_mail_addr # >/dev/null
	if [ -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1738 --message="$MAIL_ADDR@$DOMAINNAME not found"
		exit 1738
	fi

	check_mail_forward # >/dev/null
	if [ ! -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1739 --message="$MAIL_FORWARD exists"
		exit 1739
	fi
}
function mail_addr_forward_create() {
	$SQLITE $MAIL_DB "insert into alias values(NULL,'$DOMAINNAME','$MAIL_ADDR@$DOMAINNAME','$MAIL_FORWARD','virtual','1');"
	$KWNG_LOG --success --code=1718 --message="$MAIL_FORWARD added forwarding"
	exit 0
}

function mail_addr_forward_remove_check_flag() {
	if [ -z "$MAIL_ADDR" ] || [ -z "$MAIL_FORWARD" ]; then
		$KWNG_LOG --error --code=1742 --message="Missing arguments"
		exit 1742
	fi

	DOMAINNAME=$(echo $MAIL_ADDR | awk -F'@' '{print $2}')
	MAIL_ADDR=$(echo $MAIL_ADDR | awk -F'@' '{print $1}')

	check_mail_forward >/dev/null
	if [ -z "$STATUS" ]; then
		$KWNG_LOG --error --code=1741 --message="$MAIL_FORWARD not found for forward"
		exit 1741
	fi

}
function mail_addr_forward_remove() {
	$SQLITE $MAIL_DB "delete from alias where target='$MAIL_FORWARD' and domain='$DOMAINNAME';"
	$KWNG_LOG --success --code=1719 --message="Forwarding removed from $MAIL_ADDR"
	exit 0
}

check_command
check_root

PROC_MESSAGE=$(echo "Process:$0 $@" | sed 's|["'\'']||g')
[[ -f $PANEL_CORE_DIR/bin/debug ]] && $KWNG_LOG --debug --code=999 --message="$PROC_MESSAGE"

PROCESS="$1"
case $PROCESS in
--create)
	shift
	main_case $@
	domain_create_check_flag
	domain_create
	;;
--update)
	shift
	main_case $@
	domain_update_check_flag
	domain_update
	;;
--remove)
	shift
	main_case $@
	domain_remove_check_flag
	domain_remove
	;;
--create-mail)
	shift
	main_case $@
	mail_addr_create_check_flag
	mail_addr_create
	;;
--update-mail)
	shift
	main_case $@
	mail_addr_update_check_flag
	mail_addr_update
	;;
--remove-mail)
	shift
	main_case $@
	mail_addr_remove_check_flag
	mail_addr_remove
	;;
--domain-settings)
	shift
	main_case $@
	domain_settings_check_flag
	domain_settings
	;;
--set-domain-limit)
	shift
	main_case $@
	set_domain_limit_settings_check_flag
	set_domain_limit_settings
	;;
--create-mail-alias)
	shift
	main_case $@
	mail_addr_alias_create_check_flag
	mail_addr_alias_create
	;;
--remove-mail-alias)
	shift
	main_case $@
	mail_addr_alias_remove_check_flag
	mail_addr_alias_remove
	;;
--create-mail-forward)
	shift
	main_case $@
	mail_addr_forward_create_check_flag
	mail_addr_forward_create
	;;
--remove-mail-forward)
	shift
	main_case $@
	mail_addr_forward_remove_check_flag
	mail_addr_forward_remove
	;;
--autorespond)
	shift
	main_case $@
	mail_addr_autorespond_check_flag
	mail_addr_autorespond
	;;
--suspend)
	shift
	main_case $@
	domain_suspend_check_flag
	domain_suspend
	;;
--unsuspend)
	shift
	main_case $@
	domain_unsuspend_check_flag
	domain_unsuspend
	;;
--suspend-mail)
	shift
	main_case $@
	mail_addr_suspend_check_flag
	mail_addr_suspend
	;;
--unsuspend-mail)
	shift
	main_case $@
	mail_addr_unsuspend_check_flag
	mail_addr_unsuspend
	;;
esac
