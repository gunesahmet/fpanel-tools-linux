#!/bin/bash

# Encrypted by FPanel-Compiler

exec 2>/dev/null
declare -A KEY VALUE

function check_command() {
	KWNG_LOG="/usr/local/fpanel/core/sbin/logger"
	KWNG_ENV="/usr/local/fpanel/core/sbin/env"

	if [ -x "$KWNG_ENV" ]
		then
			IFS='
			'
			export `$KWNG_ENV --debug | grep -v "^#"`
			IFS=' '
		else
			$KWNG_LOG --error --code=1000 --message="Unable to set env(), please re-install packages kwng-compiler."
			exit 1000
	fi
	if [ -f $SYSTEM_PACKAGE_CONF ]; then
		. $SYSTEM_PACKAGE_CONF
		else
			$KWNG_LOG --error --code=1002 --message="Unable to load installed system packages. Please contact with system administrator."
			exit 1002
	fi

	case "$SYSTEM_TYPE" in
		debian|ubuntu)
			if [ "$HTTPD_SERVER" = "apache" ]; then
                            MODULES_BIN_DIR="/usr/lib/apache2/modules"
                            MODULES_ENABLED_CONF_DIR="/etc/apache2/mods-enabled"
                            MODULES_AVALIABLE_CONF_DIR="/etc/apache2/mods-available"
                            ALL_MODULES=`ls $MODULES_AVALIABLE_CONF_DIR/*.load | sed -e's:'"$MODULES_AVALIABLE_CONF_DIR"'::g' -e 's/.load//g' -e 's/\///g' | tr "\n" " "`
			elif [ "$HTTPD_SERVER" = "nginx" ]; then
                            MODULES_BIN_DIR="/usr/lib/apache2/modules"
                            MODULES_ENABLED_CONF_DIR="/etc/nginx/modules-enabled"
                            MODULES_AVALIABLE_CONF_DIR="/usr/share/nginx/modules-available"
                            ALL_MODULES=`ls $MODULES_AVALIABLE_CONF_DIR/*.conf | sed -e's:'"$MODULES_AVALIABLE_CONF_DIR"'::g' -e 's/.conf//g'  -e 's/\///g' | tr "\n" " "`
			fi
              ;;
		centos)
			if [ "$HTTPD_SERVER" = "apache" ]; then
                            MODULES_BIN_DIR="/etc/httpd/modules"
                            MODULES_ENABLED_CONF_DIR="/etc/httpd/mods-enabled"
                            MODULES_AVALIABLE_CONF_DIR="/etc/httpd/mods-available"
                            ALL_MODULES=`ls $MODULES_AVALIABLE_CONF_DIR/*.load | sed -e's:'"$MODULES_AVALIABLE_CONF_DIR"'::g' -e 's/.load//g' -e 's/\///g' | tr "\n" " "`
			elif [ "$HTTPD_SERVER" = "nginx" ]; then
                            MODULES_BIN_DIR="/usr/lib/apache2/modules"
                            MODULES_ENABLED_CONF_DIR="/etc/apache2/mods-enabled"
                            MODULES_AVALIABLE_CONF_DIR="/etc/apache2/mods-available"
                            ALL_MODULES=`ls /usr/lib64/nginx/modules`
			fi
              ;;
	esac

	if [ "$ALL_MODULES" != "" ]; then
              for index in "$ALL_MODULES"
              do
                     KEY[$index]="$index"
              done
	fi

	if [ "$HTTPD_SERVER" = "apache" ]; then
              KEY[php5_handler]="php5_handler"
              KEY[perl_handler]="perl_handler"
              KEY[python_handler]="python_handler"
	fi
}
function check_root() {
	if [ $(id -u) -ne 0 ]
		then
			$KWNG_LOG --error --code=1001 --message="Tool is running without root privileges"
			exit 1001
	fi

}

function usage() {
	echo "Usage" >/dev/null
}

function main_case() {
	while [ "$1" != "" ]
	do
		case $1 in
			# Json Data
			--data=*)
				DATA=`echo "$1" | sed 's/--data=//g'`
			;;
			--web-server=*)
				WEB_SERVER_TYPE=`echo "$1" | sed 's/--web-server=//g'`
			;;
			# Settings icin parametreler
			--keep-alive=*)
				KEEP_ALIVE=`echo $1 | sed -e 's/--keep-alive=//g' -e 's/"//g'`
			;;
			--keep-alive-timeout=*)
				KEEP_ALIVE_TIMEOUT=`echo $1 | sed -e 's/--keep-alive-timeout=//g' -e 's/"//g'`
			;;
			--server-timeout=*)
				SERVER_TIMEOUT=`echo $1 | sed -e 's/--server-timeout=//g' -e 's/"//g'`
			;;
			--max-keep-alive-req=*)
				MAX_KEEP_ALIVE_REQUESTS=`echo $1 | sed -e 's/--max-keep-alive-req=//g' -e 's/"//g'`
			;;
			--start-server=*)
				PREFORK_START_SERVER=`echo $1 | sed -e 's/--start-server=//g' -e 's/"//g'`
			;;
			--min-spare-server=*)
				PREFORK_MIN_SPARE_SERVERS=`echo $1 | sed -e 's/--min-spare-server=//g' -e 's/"//g'`
			;;
			--max-clients=*)
				PREFORK_MAX_CLIENTS=`echo $1 | sed -e 's/--max-clients=//g' -e 's/"//g'`
			;;
			--max-req-per-child=*)
				PREFORK_MAX_REQUESTS_PER_CHILD=`echo $1 | sed -e 's/--max-req-per-child=//g' -e 's/"//g'`
			;;
			# Nginx Ayarlari
			--worker_processes=*)
				WORKER_PROCESSES=`echo "$1" | sed 's/--worker_processes=//g'`
			;;
			--worker_connections=*)
				WORKER_CONNECTIONS=`echo "$1" | sed 's/--worker_connections=//g'`
			;;
			--keepalive_timeout=*)
				KEEPALIVE_TIMEOUT=`echo "$1" | sed 's/--keepalive_timeout=//g'`
			;;
			--types_hash_max_size=*)
				TYPES_HASH_MAX_SIZE=`echo "$1" | sed 's/--types_hash_max_size=//g'`
			;;
			--server_names_hash_bucket_size=*)
				SERVER_NAMES_HASH_BUCKET_SIZE=`echo "$1" | sed 's/--server_names_hash_bucket_size=//g'`
			;;
			--multi_accept=*)
				MULTI_ACCEPT=`echo "$1" | sed 's/--multi_accept=//g'`
			;;
			--sendfile=*)
				SENDFILE=`echo "$1" | sed 's/--sendfile=//g'`
			;;
			--tcp_nopush=*)
				TCP_NOPUSH=`echo "$1" | sed 's/--tcp_nopush=//g'`
			;;
			--tcp_nodelay=*)
				TCP_NODELAY=`echo "$1" | sed 's/--tcp_nodelay=//g'`
			;;
			--server_tokens=*)
				SERVER_TOKENS=`echo "$1" | sed 's/--server_tokens=//g'`
			;;
			--server_name_in_redirect=*)
				SERVER_NAME_IN_REDIRECT=`echo "$1" | sed 's/--server_name_in_redirect=//g'`
			;;
			--gzip=*)
				GZIP=`echo "$1" | sed 's/--gzip=//g'`
			;;
			--gzip_vary=*)
				GZIP_VARY=`echo "$1" | sed 's/--gzip_vary=//g'`
			;;
			--gzip_buffers=*)
				GZIP_BUFFERS=`echo "$1" | sed 's/--gzip_buffers=//g'`
			;;
			--gzip_disable=*)
				GZIP_DISABLE=`echo "$1" | sed 's/--gzip_disable=//g'`
			;;
			--gzip_proxied=*)
				GZIP_PROXIED=`echo "$1" | sed 's/--gzip_proxied=//g'`
			;;
			--gzip_comp_level=*)
				GZIP_COMP_LEVEL=`echo "$1" | sed 's/--gzip_comp_level=//g'`
			;;
			--gzip_http_version=*)
				GZIP_HTTP_VERSION=`echo "$1" | sed 's/--gzip_http_version=//g'`
			;;
			--gzip_types=*)
				GZIP_TYPES=`echo "$1" | sed 's/--gzip_types=//g'`
			;;
                     --file-ext=*)
                            FILE_EXT=`echo "$1" | sed 's/--file-ext=//g'`
                     ;;
                     --file-ext-octet=*)
                            FILE_EXT_OCTET=`echo "$1" | sed 's/--file-ext-octet=//g'`
                     ;;
              esac
		shift
	done
}

function write_json() {
	echo "$1" | sed -e 's/,/","/g' -e 's/:/":"/g' -e 's/^/{"/g' -e 's/$/"}/g' # -e 's/ //g'
}

function apache_mime_type_show() {
	JSON_DATA=`cat /etc/mime.types | grep -v "^#" | grep . | awk -F' ' '{print $1":"$2" "$3" "$4" "$5" "$6" "$7}' | sed -e 's/^/"/' -e 's/:/":"/g' -e 's/\s*$/"/g' | tr '\n' ',' | sed -e 's/,$//g'`
}
function nginx_mime_type_show() {
	JSON_DATA=`cat /etc/nginx/mime.types | grep -v "#" | grep -v "types.*{" | grep -v "}" |grep . | awk -F' ' '{print $1":"$2" "$3" "$4" "$5" "$6" "$7}' | sed -e 's/^/"/' -e 's/:/":"/g' -e 's/\s*$/"/g' | tr '\n' ',' | sed -e 's/,$//g' | tr "\n" " "`
}
function mime_type_show() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_mime_type_show
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_mime_type_show
	echo "{$JSON_DATA}" | base64

}

function mime_type_add_check_flag() {
	if [ -z $FILE_EXT ] || [ -z $FILE_EXT_OCTET ]
		then
			$KWNG_LOG --error --code=7102 --message="Missing arguments"
			echo "Error7102: Missing arguments"
			exit 7102
	fi
}
function apache_mime_type_add() {
	echo "$FILE_EXT_OCTET                               $FILE_EXT" >> $MIME_TYPES_CONFIG
}
function nginx_mime_type_add() {
	sed -i 's/}//g' /etc/nginx/mime.types
	echo "    $FILE_EXT_OCTET                               $FILE_EXT" >> /etc/nginx/mime.types
	echo "}" >> /etc/nginx/mime.types

}
function mime_type_add() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_mime_type_add
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_mime_type_add
	$KWNG_LOG --success --code=7101 --message="Mime type added"
}

function mime_type_remove_check_flag() {
	if [ -z $FILE_EXT ]
		then
			$KWNG_LOG --error --code=7103 --message="Missing arguments"
			echo "Error7103: Missing arguments"
			exit 7103
	fi
}
function apache_mime_type_remove() {
	# websrvmng "--remove-mimetype" "--file-ext=.php123" "--file-ext-octet=application/atom+xml"
	FILE_EXT=`echo $FILE_EXT |sed 's/#/ /g'`
	sed -i 's/^.*'"$FILE_EXT"'$//g' /etc/mime.types
	sed -i '/^$/d' /etc/mime.types
}
function nginx_mime_type_remove() {
	FILE_EXT=`echo $FILE_EXT |sed 's/#/ /g'`
	sed -i 's/^.*'"$FILE_EXT"'$//g' /etc/nginx/mime.types
	sed -i '/^$/d' /etc/mime.types
}
function mime_type_remove() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_mime_type_remove
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_mime_type_remove
	$KWNG_LOG --success --code=7102 --message="Mime type removed"

}

function apache_init() {
	apache_rewrite true
	name_vhosts_reload
}
function nginx_init() {
	name_vhosts_reload
}
function webserver_init() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_init
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_init
	$KWNG_LOG --success --code=7103 --message="Apache initialized"
}

function apache_show_modules() {
	# apache_init_modules

	# Mod listesi
	# actions alias asis auth_basic auth_digest authn_alias authn_anon authn_dbd authn_dbm authn_default authn_file authnz_ldap authz_dbm authz_default authz_groupfile authz_host authz_owner authz_user autoindex cache cern_meta cgi cgid charset_lite dav dav_fs dav_lock dbd deflate dir disk_cache dump_io env expires ext_filter fcgid file_cache filter headers ident imagemap include info ldap log_forensic mem_cache mime mime_magic negotiation perl php5 proxy_ajp proxy_balancer proxy proxy_connect proxy_ftp proxy_http rewrite setenvif speling ssl status substitute suexec unique_id userdir usertrack version vhost_alias
	unset JSON_DATA

	# PHP_MODULE="$MODULES_BIN_DIR/libphp5.so"


	for index in ${!KEY[*]}
	do
		# Modul yuklu ve conf varsa on, yoksa off degeri verilecek.
		if [ -f $MODULES_ENABLED_CONF_DIR/$index.load ]
			then
				VALUE[$index]="on"
			else
				VALUE[$index]="off"
		fi

		[ -z "$JSON_DATA" ] && JSON_DATA="$index:${VALUE[$index]}" || JSON_DATA="$JSON_DATA,$index:${VALUE[$index]}"

	done


}
function nginx_show_modules() {
	unset JSON_DATA

	for index in ${!KEY[*]}
	do
              if [ -f $MODULES_ENABLED_CONF_DIR/*$index.conf ]; then
                     VALUE[$index]="on"
              else
                     VALUE[$index]="off"
              fi
		[ -z "$JSON_DATA" ] && JSON_DATA="$index:${VALUE[$index]}" || JSON_DATA="$JSON_DATA,$index:${VALUE[$index]}"
	done
	JSON_DATA="$JSON_DATA"
}
function show_modules() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_show_modules
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_show_modules
	write_json "$JSON_DATA"
}

function apache_load_modules() {
	MODULE_NAME=`echo $1 | sed -e 's/=/ /g' -e 's/--//g'| awk '{print $1}'`
	MODULE_STATUS=`echo $1 | sed 's/=/ /g' | awk '{print $2}'`
       if [ -z "$MODULE_NAME" ]; then
              $KWNG_LOG --error --code=7106 --message="Module name can not be empty"
              exit 7106
       fi
	# echo $MODULE_NAME
	# echo $MODULE_STATUS

	# for index in ${!KEY[*]}
	# do
		# if [ "${VALUE[$index]}" = "on" ]
			# then
				# # echo ${VALUE[$index]}
				# # Deger on olarak geldigi icin modulun conf dosyasi ilgili yere yerlestiriliyor...
				# if [ -f $MODULES_AVALIABLE_CONF_DIR/$index.conf ]
					# then
						# cp -Rp $MODULES_AVALIABLE_CONF_DIR/$index.conf $MODULES_ENABLED_CONF_DIR/
				# fi
				# if [ -f $MODULES_AVALIABLE_CONF_DIR/$index.load ]
					# then
						# cp -Rp $MODULES_AVALIABLE_CONF_DIR/$index.load $MODULES_ENABLED_CONF_DIR/
				# fi
		# fi
		# if [ "${VALUE[$index]}" = "off" ]
			# then
				# if [ -z "${VALUE[$index]}" ] || [ "${VALUE[$index]}" = "off" ]
					# then
						# # Deger off yada bos olarak geldigi icin modulun conf dosyasi ilgili yerden siliniyor eger varise...
						# if [ -f $MODULES_ENABLED_CONF_DIR/$index.conf ]
							# then
								# rm -rf $MODULES_ENABLED_CONF_DIR/$index.conf
						# fi
						# if [ -f $MODULES_ENABLED_CONF_DIR/$index.load ]
							# then
								# rm -rf $MODULES_ENABLED_CONF_DIR/$index.load
						# fi
				# fi
		# fi
	# done
	if [ "$MODULE_STATUS" = "off" ]
       then
              if [ -f $MODULES_ENABLED_CONF_DIR/$MODULE_NAME.conf ]
              then
                     rm -rf $MODULES_ENABLED_CONF_DIR/$MODULE_NAME.conf
              fi
              if [ -f $MODULES_ENABLED_CONF_DIR/$MODULE_NAME.load ]
              then
                     rm -rf $MODULES_ENABLED_CONF_DIR/$MODULE_NAME.load
              fi
       else
              if [ -f $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.conf ]
              then
                     cp -Rp $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.conf $MODULES_ENABLED_CONF_DIR/
              fi
              if [ -f $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.load ]
              then
                     cp -Rp $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.load $MODULES_ENABLED_CONF_DIR/
              fi
	fi


	# Rewrite ozel durumu
	if [ "${VALUE[rewrite]}" = "on" ]; then
              apache_rewrite true
       else
              apache_rewrite false
	fi

}
function nginx_load_modules() {
	MODULE_NAME=`echo $1 | sed -e 's/=/ /g' -e 's/--//g'| awk '{print $1}'`
       MODULE_STATUS=`echo $1 | sed 's/=/ /g' | awk '{print $2}'`
       if [ -z "$MODULE_NAME" ]; then
              $KWNG_LOG --error --code=7106 --message="Module name can not be empty"
              exit 7106
       fi
       if [ "$MODULE_STATUS" = "off" ]; then
              if [ ! -z "$MODULE_NAME" ]; then
                     PRIORITY="50"
                     [ "$MODULE_NAME" == "mod-http-ndk" ] && PRIORITY="10"
                     if [ -f $MODULES_ENABLED_CONF_DIR/"${PRIORITY}-${MODULE_NAME}.conf" ]; then
                            rm -rf $MODULES_ENABLED_CONF_DIR/"${PRIORITY}-${MODULE_NAME}.conf"
                     fi
              fi
       else
              #mod-http-ndk icin 10 digerleri 50
              if [ -f $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.conf ]; then
                     if [ ! -z "$MODULE_NAME" ]; then
                            PRIORITY="50"
                            [ "$MODULE_NAME" == "mod-http-ndk" ] && PRIORITY="10"
                            ln -s $MODULES_AVALIABLE_CONF_DIR/$MODULE_NAME.conf $MODULES_ENABLED_CONF_DIR/"${PRIORITY}-${MODULE_NAME}.conf"
                     fi
              fi
	fi

}
function load_modules() {
       if [ -z "$HTTPD_SERVER" ]; then
              $KWNG_LOG --error --code=7106 --message="Can not found installed any web server"
              exit 7106
       fi
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_load_modules "$@"
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_load_modules "$@"
	$SERVICESMNG --reload --service=web
	$KWNG_LOG --success --code=7106 --message="Web server modules loaded"
}

function apache_rewrite() {
	# ReWrite icin ozel kural devreye giriyor..
	if [ "$1" = "true" ]
		then
			cp -Rp $MODULES_AVALIABLE_CONF_DIR/rewrite.conf $MODULES_ENABLED_CONF_DIR/
			sed -i 's/AllowOverride.*/AllowOverride All/g' $APACHE_DEFAULT_CONF
		else
			rm -rf $MODULES_ENABLED_CONF_DIR/rewrite.conf
			sed -i 's/AllowOverride.*/AllowOverride None/g' $APACHE_DEFAULT_CONF
	fi
}

function apache_name_vhosts_reload() {
	DOMAINNAME=`hostname`

	if [ ! -d $VHOSTS_DEFAULT_DIR ]
		then
			mkdir -p $VHOSTS_DEFAULT_DIR
	fi

	echo "# FPanel - Dont edit this file." > $APACHE_NAME_VHOST_CONF
	echo "# FPanel - Dont edit this file." > $APACHE_DEFAULT_VHOST_CONF

	while read line
	do
		[ "$line" = "127.0.0.1" ] && continue
		IPADDR="$line"

		echo -en "NameVirtualHost $IPADDR:80\nNameVirtualHost $IPADDR:443\n" >>  $APACHE_NAME_VHOST_CONF
		echo "
<VirtualHost $IPADDR:80>
	UseCanonicalName Off
	ServerAdmin  "admin@localhost"
	DocumentRoot $VHOSTS_DEFAULT_DIR

	<Directory $VHOSTS_DEFAULT_DIR>
		Options -Indexes -Includes +ExecCGI
	</Directory>
</VirtualHost>" >> $APACHE_DEFAULT_VHOST_CONF

	done < <(ip addr | grep -w "inet" | awk -F' ' '{print $2}' | awk -F'/' '{print $1}')
}
