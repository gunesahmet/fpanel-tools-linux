function apache_show_settings() {
	case "$SYSTEM_TYPE" in
		debian|ubuntu)
		       apache_show_settings_debian
		;;
              centos)
                     apache_show_settings_centos
              ;;
       esac
}
function nginx_show_settings() {
	JSON_DATA=""
	### General ###
	# worker_processes 4;
	NGINX_CONFIG=`cat $NGINX_DEFAULT_CONF`
	WORKER_PROCESSES=`echo $NGINX_CONFIG | grep "\<worker_processes\>" | sed 's/worker_processes//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"worker_processes\":\"$WORKER_PROCESSES\","
	### Events ###
	# worker_connections 768;
	WORKER_CONNECTIONS=`echo $NGINX_CONFIG | grep "\<worker_connections\>" | sed 's/worker_connections//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"worker_connections\":\"$WORKER_CONNECTIONS\","
	# multi_accept on;
	MULTI_ACCEPT=`echo $NGINX_CONFIG | grep "\<multi_accept\>" | sed 's/multi_accept//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"multi_accept\":\"$MULTI_ACCEPT\","

	### http ###
	# sendfile on;
	SENDFILE=`echo $NGINX_CONFIG | grep "\<sendfile\>" | sed 's/sendfile//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"sendfile\":\"$SENDFILE\","
	# tcp_nopush on;
	TCP_NOPUSH=`echo $NGINX_CONFIG | grep "\<tcp_nopush\>" | sed 's/tcp_nopush//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"tcp_nopush\":\"$TCP_NOPUSH\","
	# tcp_nodelay on;
	TCP_NODELAY=`echo $NGINX_CONFIG | grep "\<tcp_nodelay\>" | sed 's/tcp_nodelay//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"tcp_nodelay\":\"$TCP_NODELAY\","
	# keepalive_timeout 65;
	KEEPALIVE_TIMEOUT=`echo $NGINX_CONFIG | grep "\<keepalive_timeout\>" | sed 's/keepalive_timeout//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"keepalive_timeout\":\"$KEEPALIVE_TIMEOUT\","
	# types_hash_max_size 2048;
	TYPES_HASH_MAX_SIZE=`echo $NGINX_CONFIG | grep "\<types_hash_max_size\>" | sed 's/types_hash_max_size//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"types_hash_max_size\":\"$TYPES_HASH_MAX_SIZE\","
	# server_tokens off;
	SERVER_TOKENS=`echo $NGINX_CONFIG | grep "\<server_tokens\>" | sed 's/server_tokens//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"server_tokens\":\"$SERVER_TOKENS\","
	# server_names_hash_bucket_size 64;
	SERVER_NAMES_HASH_BUCKET_SIZE=`echo $NGINX_CONFIG | grep "\<server_names_hash_bucket_size\>" | sed 's/server_names_hash_bucket_size//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"server_names_hash_bucket_size\":\"$SERVER_NAMES_HASH_BUCKET_SIZE\","
	# server_name_in_redirect off;
	SERVER_NAME_IN_REDIRECT=`echo $NGINX_CONFIG | grep "\<server_name_in_redirect\>" | sed 's/server_name_in_redirect//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"server_name_in_redirect\":\"$SERVER_NAME_IN_REDIRECT\","

	# Gzip
	# gzip on;
	GZIP=`echo $NGINX_CONFIG | grep "\<gzip\>" | sed 's/gzip//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip\":\"$GZIP\","
	# gzip_disable "msie6";
	GZIP_DISABLE=`echo $NGINX_CONFIG | grep "\<gzip_disable\>" | sed 's/gzip_disable//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' -e 's/"//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_disable\":\"$GZIP_DISABLE\","

	# gzip_vary on;
	GZIP_VARY=`echo $NGINX_CONFIG | grep "\<gzip_vary\>" | sed 's/gzip_vary//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_vary\":\"$GZIP_VARY\","
	# gzip_proxied any;
	GZIP_PROXIED=`echo $NGINX_CONFIG | grep "\<gzip_proxied\>" | sed 's/gzip_proxied//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_proxied\":\"$GZIP_PROXIED\","
	# gzip_comp_level 6;
	GZIP_COMP_LEVEL=`echo $NGINX_CONFIG | grep "\<gzip_comp_level\>" | sed 's/gzip_comp_level//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_comp_level\":\"$GZIP_COMP_LEVEL\","
	# gzip_buffers 16 8k;
	GZIP_BUFFERS=`echo $NGINX_CONFIG | grep "\<gzip_buffers\>" | sed 's/gzip_buffers//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_buffers\":\"$GZIP_BUFFERS\","
	# gzip_http_version 1.1;
	GZIP_HTTP_VERSION=`echo $NGINX_CONFIG | grep "\<gzip_http_version\>" | sed 's/gzip_http_version//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_http_version\":\"$GZIP_HTTP_VERSION\","
	# gzip_types text/plain text/css application/json application/x-javascript text/xml application/xml application/xml+rss text/javascript;
	GZIP_TYPES=`echo $NGINX_CONFIG | grep "\<gzip_types\>" | sed 's/gzip_types//g' | sed -e 's/^[ \t]*//' -e 's/\n//g' -e 's/;//g' | grep -v "#"`
	JSON_DATA="$JSON_DATA\"gzip_types\":\"$GZIP_TYPES\""

	echo "{$JSON_DATA}"


}
function show_settings() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_show_settings
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_show_settings
}

function apache_save_settings_debian() {
       TMP_VAR=`head /dev/urandom | tr -dc A-Za-z0-9 | head -c 13 ; echo ''`
       cp -rf $APACHE_DEFAULT_CONF $PANEL_TMP_DIR/apache.conf.$TMP_VAR.tmp

       if [ ! -z $KEEP_ALIVE ]
       then
              if [ "$KEEP_ALIVE" = "on" ]
              then
                     KEEP_ALIVE="KeepAlive On"
              else
                     KEEP_ALIVE="KeepAlive Off"
              fi
              sed -i 's/^KeepAlive .*/'"$KEEP_ALIVE"'/g' $APACHE_DEFAULT_CONF
       fi

       if [ ! -z $KEEP_ALIVE_TIMEOUT ]
       then
              KEEP_ALIVE_TIMEOUT="KeepAliveTimeout $KEEP_ALIVE_TIMEOUT"
              sed -i 's/^KeepAliveTimeout .*/'"$KEEP_ALIVE_TIMEOUT"'/g' $APACHE_DEFAULT_CONF
       fi

       if [ ! -z $SERVER_TIMEOUT ]
       then
              SERVER_TIMEOUT="Timeout $SERVER_TIMEOUT"
              sed -i 's/^Timeout .*/'"$SERVER_TIMEOUT"'/g' $APACHE_DEFAULT_CONF
       fi


       if [ ! -z $MAX_KEEP_ALIVE_REQUESTS ]
       then
              MAX_KEEP_ALIVE_REQUESTS="MaxKeepAliveRequests $MAX_KEEP_ALIVE_REQUESTS"
              sed -i 's/^MaxKeepAliveRequests .*/'"$MAX_KEEP_ALIVE_REQUESTS"'/g' $APACHE_DEFAULT_CONF
       fi

       if [ "$SYSTEM_VERSION" == "10" ]
       then
              if [ -f $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf ]
              then
                     if [ ! -z $PREFORK_START_SERVER ]
                     then
                            sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /StartServers/        s/[0-9][0-9]*/"$PREFORK_START_SERVER"/
                            }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
                     fi

                     if [ ! -z $PREFORK_MIN_SPARE_SERVERS ]
                     then
                            sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MinSpareServers/      s/[0-9][0-9]*/"$PREFORK_MIN_SPARE_SERVERS"/
                            }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
                     fi

                     if [ ! -z $PREFORK_MAX_CLIENTS ]
                     then
                            sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MaxRequestWorkers/          s/[0-9][0-9]*/"$PREFORK_MAX_CLIENTS"/
                            }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
                     fi

                     if [ ! -z $PREFORK_MAX_REQUESTS_PER_CHILD ]
                     then
                            sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MaxConnectionsPerChild/ s/[0-9][0-9]*/"$PREFORK_MAX_REQUESTS_PER_CHILD"/
                            }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
                     fi
              fi
       fi
       $APACHE_BIN configtest > /dev/null 2>&1
       RETVAL=$?

       if [ "$RETVAL" != "0" ]
       then
              mv $PANEL_TMP_DIR/apache.conf.$TMP_VAR.tmp $APACHE_DEFAULT_CONF
              $KWNG_LOG --error --code=7103 --message="Config test failed. Detail"
              echo "Error7103: Config test failed."
              exit 7103
       fi
}
function apache_save_settings_centos() {
       TMP_VAR=`head /dev/urandom | tr -dc A-Za-z0-9 | head -c 13 ; echo ''`
       cp -rf $APACHE_DIR/conf.d/general.conf $PANEL_TMP_DIR/apache.general.conf.$TMP_VAR.tmp

       if [ ! -z $KEEP_ALIVE ]
       then
              if [ "$KEEP_ALIVE" = "on" ]
              then
                     KEEP_ALIVE="KeepAlive On"
              else
                     KEEP_ALIVE="KeepAlive Off"
              fi

              sed -i 's/^KeepAlive .*/'"$KEEP_ALIVE"'/g' $APACHE_DIR/conf.d/general.conf
       fi

       if [ ! -z $KEEP_ALIVE_TIMEOUT ]
       then
              KEEP_ALIVE_TIMEOUT="KeepAliveTimeout $KEEP_ALIVE_TIMEOUT"
              sed -i 's/^KeepAliveTimeout .*/'"$KEEP_ALIVE_TIMEOUT"'/g' $APACHE_DIR/conf.d/general.conf
       fi

       if [ ! -z $SERVER_TIMEOUT ]
       then
              SERVER_TIMEOUT="Timeout $SERVER_TIMEOUT"
              sed -i 's/^Timeout .*/'"$SERVER_TIMEOUT"'/g' $APACHE_DIR/conf.d/general.conf
       fi

       if [ ! -z $MAX_KEEP_ALIVE_REQUESTS ]
       then
              MAX_KEEP_ALIVE_REQUESTS="MaxKeepAliveRequests $MAX_KEEP_ALIVE_REQUESTS"
              sed -i 's/^MaxKeepAliveRequests .*/'"$MAX_KEEP_ALIVE_REQUESTS"'/g' $APACHE_DIR/conf.d/general.conf
       fi

       if [ -f $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf ]
              then
              if [ ! -z $PREFORK_START_SERVER ]
                     then
                     sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /StartServers/        s/[0-9][0-9]*/"$PREFORK_START_SERVER"/
                     }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
              fi

              if [ ! -z $PREFORK_MIN_SPARE_SERVERS ]
              then
                     sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MinSpareServers/      s/[0-9][0-9]*/"$PREFORK_MIN_SPARE_SERVERS"/
                     }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
              fi

              if [ ! -z $PREFORK_MAX_CLIENTS ]
              then
                     sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MaxRequestWorkers/          s/[0-9][0-9]*/"$PREFORK_MAX_CLIENTS"/
                     }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
              fi

              if [ ! -z $PREFORK_MAX_REQUESTS_PER_CHILD ]
              then
                     sed -i "/^<IfModule mpm_prefork_module*/,/^<\/IfModule>/ {
                            /MaxConnectionsPerChild/ s/[0-9][0-9]*/"$PREFORK_MAX_REQUESTS_PER_CHILD"/
                     }" $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf
              fi
       fi

       $APACHE_BIN -t > /dev/null 2>&1
       RETVAL=$?

       if [ "$RETVAL" != "0" ]
       then
              mv $PANEL_TMP_DIR/apache.general.conf.$TMP_VAR.tmp $APACHE_DIR/conf.d/general.conf
              $KWNG_LOG --error --code=7103 --message="Config test failed. Detail"
              echo "Error7103: Config test failed."
              exit 7103
       fi
}
function apache_save_settings() {
	case "$SYSTEM_TYPE" in
		debian|ubuntu)
		       apache_save_settings_debian
		;;
              centos)
                     apache_save_settings_centos
              ;;
       esac
}
function nginx_save_settings() {
	if [ ! -f $NGINX_DEFAULT_CONF.tmp ]
		then
		rm -rf $NGINX_DEFAULT_CONF.tmp
	fi
	cp -rf $NGINX_DEFAULT_CONF $NGINX_DEFAULT_CONF.tmp

	OLD_WORKER_PROCESSES=`cat $NGINX_DEFAULT_CONF | grep "\<worker_processes\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_WORKER_CONNECTIONS=`cat $NGINX_DEFAULT_CONF | grep "\<worker_connections\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_MULTI_ACCEPT=`cat $NGINX_DEFAULT_CONF | grep "\<multi_accept\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`

	OLD_SENDFILE=`cat $NGINX_DEFAULT_CONF | grep "\<sendfile\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_TCP_NOPUSH=`cat $NGINX_DEFAULT_CONF | grep "\<tcp_nopush\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_TCP_NODELAY=`cat $NGINX_DEFAULT_CONF | grep "\<tcp_nodelay\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_KEEPALIVE_TIMEOUT=`cat $NGINX_DEFAULT_CONF | grep "\<keepalive_timeout\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_TYPES_HASH_MAX_SIZE=`cat $NGINX_DEFAULT_CONF | grep "\<types_hash_max_size\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_SERVER_TOKENS=`cat $NGINX_DEFAULT_CONF | grep "\<server_tokens\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_SERVER_NAMES_HASH_BUCKET_SIZE=`cat $NGINX_DEFAULT_CONF | grep "\<server_names_hash_bucket_size\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_SERVER_NAME_IN_REDIRECT=`cat $NGINX_DEFAULT_CONF | grep "\<server_name_in_redirect\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`


	OLD_GZIP=`cat $NGINX_DEFAULT_CONF | grep "\<gzip\>" | sed 's/^gzip//g' | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_DISABLE=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_disable\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_VARY=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_vary\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_PROXIED=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_proxied\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_COMP_LEVEL=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_comp_level\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_BUFFERS=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_buffers\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_HTTP_VERSION=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_http_version\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`
	OLD_GZIP_TYPES=`cat $NGINX_DEFAULT_CONF | grep "\<gzip_types\>" | sed -e 's/^[ \t]*//' -e 's/\n//g'`

	if [ ! -z "$OLD_WORKER_PROCESSES" ]
		then
			[[ ! -z "$WORKER_PROCESSES" ]] && sed -i 's/'"$OLD_WORKER_PROCESSES"'/worker_processes '"$WORKER_PROCESSES"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/user.*;/a	worker_processes '"$WORKER_PROCESSES"';' $NGINX_DEFAULT_CONF
	fi
	if [ ! -z "$OLD_WORKER_CONNECTIONS" ]
		then
			[[ ! -z "$WORKER_CONNECTIONS" ]] && sed -i 's/'"$OLD_WORKER_CONNECTIONS"'/worker_connections '"$WORKER_CONNECTIONS"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/events.*{/a	worker_connections '"$WORKER_CONNECTIONS"';' $NGINX_DEFAULT_CONF
	fi

	if [ ! -z "$OLD_MULTI_ACCEPT" ]
		then
			[[ ! -z "$MULTI_ACCEPT" ]] && sed -i 's/'"$OLD_MULTI_ACCEPT"'/multi_accept '"$MULTI_ACCEPT"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/events.*{/a	multi_accept '"$MULTI_ACCEPT"';' $NGINX_DEFAULT_CONF

	fi


	if [ ! -z "$OLD_SENDFILE" ]
		then
			[[ ! -z "$SENDFILE" ]] && sed -i 's/'"$OLD_SENDFILE"'/sendfile '"$SENDFILE"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	sendfile '"$SENDFILE"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_TCP_NOPUSH" ]
		then
			[[ ! -z "$TCP_NOPUSH" ]] && sed -i 's/'"$OLD_TCP_NOPUSH"'/tcp_nopush '"$TCP_NOPUSH"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	tcp_nopush '"$TCP_NOPUSH"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_TCP_NODELAY" ]
		then
			[[ ! -z "$TCP_NODELAY" ]] && sed -i 's/'"$OLD_TCP_NODELAY"'/tcp_nodelay '"$TCP_NODELAY"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	tcp_nodelay '"$TCP_NODELAY"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_KEEPALIVE_TIMEOUT" ]
		then
			[[ ! -z "$KEEPALIVE_TIMEOUT" ]] && sed -i 's/'"$OLD_KEEPALIVE_TIMEOUT"'/keepalive_timeout '"$KEEPALIVE_TIMEOUT"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	keepalive_timeout '"$KEEPALIVE_TIMEOUT"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_TYPES_HASH_MAX_SIZE" ]
		then
			[[ ! -z "$TYPES_HASH_MAX_SIZE" ]] && sed -i 's/'"$OLD_TYPES_HASH_MAX_SIZE"'/types_hash_max_size '"$TYPES_HASH_MAX_SIZE"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	types_hash_max_size '"$TYPES_HASH_MAX_SIZE"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_SERVER_TOKENS" ]
		then
			[[ ! -z "$SERVER_TOKENS" ]] && sed -i 's/'"$OLD_SERVER_TOKENS"'/server_tokens '"$SERVER_TOKENS"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	server_tokens '"$SERVER_TOKENS"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_SERVER_NAMES_HASH_BUCKET_SIZE" ]
		then
			[[ ! -z "$SERVER_NAMES_HASH_BUCKET_SIZE" ]] && sed -i 's/'"$OLD_SERVER_NAMES_HASH_BUCKET_SIZE"'/	server_names_hash_bucket_size '"$SERVER_NAMES_HASH_BUCKET_SIZE"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	server_names_hash_bucket_size '"$SERVER_NAMES_HASH_BUCKET_SIZE"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_SERVER_NAME_IN_REDIRECT" ]
		then
			[[ ! -z "$SERVER_NAME_IN_REDIRECT" ]] && sed -i 's/'"$OLD_SERVER_NAME_IN_REDIRECT"'/	server_name_in_redirect '"$SERVER_NAME_IN_REDIRECT"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a 	server_name_in_redirect '"$SERVER_NAME_IN_REDIRECT"';' $NGINX_DEFAULT_CONF
	fi

	if [ ! -z "$OLD_GZIP" ]
		then
			[[ ! -z "$GZIP" ]] && sed -i 's/'"$OLD_GZIP"'/gzip '"$GZIP"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	gzip '"$GZIP"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_DISABLE" ]
		then
			[[ ! -z "$GZIP_DISABLE" ]] && sed -i 's/'"$OLD_GZIP_DISABLE"'/gzip_disable \"'"$GZIP_DISABLE"'\";/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	gzip_disable \"'"$GZIP_DISABLE"'\";' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_VARY" ]
		then
			[[ ! -z "$WORKER_PROCESSES" ]] && sed -i 's/'"$OLD_GZIP_VARY"'/gzip_vary '"$GZIP_VARY"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	gzip_vary '"$GZIP_VARY"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_PROXIED" ]
		then
			[[ ! -z "$GZIP_PROXIED" ]] && sed -i 's/'"$OLD_GZIP_PROXIED"'/gzip_proxied '"$GZIP_PROXIED"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	gzip_proxied '"$GZIP_PROXIED"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_COMP_LEVEL" ]
		then
			[[ ! -z "$GZIP_COMP_LEVEL" ]] && sed -i 's/'"$OLD_GZIP_COMP_LEVEL"'/gzip_comp_level '"$GZIP_COMP_LEVEL"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a	gzip_comp_level '"$GZIP_COMP_LEVEL"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_BUFFERS" ]
		then
			[[ ! -z "$GZIP_BUFFERS" ]] && sed -i 's/'"$OLD_GZIP_BUFFERS"'/gzip_buffers '"$GZIP_BUFFERS"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a gzip_buffers '"$GZIP_BUFFERS"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_HTTP_VERSION" ]
		then
			[[ ! -z "$GZIP_HTTP_VERSION" ]] && sed -i 's/'"$OLD_GZIP_HTTP_VERSION"'/gzip_http_version '"$GZIP_HTTP_VERSION"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a gzip_http_version '"$GZIP_HTTP_VERSION"';' $NGINX_DEFAULT_CONF
	fi


	if [ ! -z "$OLD_GZIP_TYPES" ]
		then
			[[ ! -z "$GZIP_TYPES" ]] && sed -i 's/'"$OLD_GZIP_TYPES"'/gzip_types '"$GZIP_TYPES"';/g' $NGINX_DEFAULT_CONF
		else
			 sed -i '/html.*{/a gzip_types '"$GZIP_TYPES"';' $NGINX_DEFAULT_CONF
	fi

	$NGINX_BIN -t > /dev/null
	RETVAL=$?
	if [ "$RETVAL" != "0" ]
		then
			MESSAGE=`$NGINX_BIN -t`
			rm -rf $NGINX_DEFAULT_CONF >/dev/null
			mv $NGINX_DEFAULT_CONF.tmp $NGINX_DEFAULT_CONF
			$KWNG_LOG --error --code=7103 --message="Config test failed. Detail: $MESSAGE"
			echo "Error7103: Config test failed. Detail: $MESSAGE"
			exit 7103
	fi
	rm -rf $NGINX_DEFAULT_CONF.tmp >/dev/null

}
function save_settings() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_save_settings
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_save_settings

	$SERVICESMNG --reload --service=web
	$KWNG_LOG --success --code=7107 --message="Web server settings saved"
}

check_command
check_root

PROCESS="$1"

PROC_MESSAGE=`echo "Process:$0 $@" | sed 's|["'\'']||g'`
[[ -f $PANEL_CORE_DIR/bin/debug ]] && $KWNG_LOG --debug --code=999 --message="$PROC_MESSAGE"

case $PROCESS in
	--init)
		shift
		webserver_init
		;;
	--init-vhosts)
		shift
		name_vhosts_reload
		;;
	--list-modules)
		shift
		main_case "$@"
		show_modules
		;;
	--load-modules)
		shift
		load_modules "$@"
		;;
	--list-mimetypes)
		mime_type_show
		;;
	--add-mimetype)
		shift
		main_case "$@"
		mime_type_add_check_flag
		mime_type_add
		;;
	--remove-mimetype)
		shift
		main_case "$@"
		mime_type_remove_check_flag
		mime_type_remove
		;;
	--server-setting)
		show_settings
		;;
	--save-setting)
		shift
		main_case "$@"
		save_settings
		;;
esac
