function name_vhosts_reload() {
	[[ "$HTTPD_SERVER" = "apache" ]] && apache_name_vhosts_reload
	[[ "$HTTPD_SERVER" = "nginx" ]] && nginx_name_vhosts_reload

	[[ "$HTTPD_SERVER" = "nginx" ]] && $SERVICESMNG --reload --service=php_fpm
	$SERVICESMNG --reload --service=web
	$KWNG_LOG --success --code=7105 --message="Apache virtual hosts reloaded"
}

function apache_show_settings_debian() {
	# for Prefork
	PREFORK=`cat $APACHE_DEFAULT_CONF | sed  '/<IfModule worker.c>.*/,/<\/IfModule>$/s/^/#/'`

	KEEP_ALIVE=`cat $APACHE_DEFAULT_CONF | grep "^KeepAlive " | awk '{print $2}'`
	KEEP_ALIVE_TIMEOUT=`cat $APACHE_DEFAULT_CONF | grep "^KeepAliveTimeout " | awk '{print $2}'`
	MAX_KEEP_ALIVE_REQUESTS=`cat $APACHE_DEFAULT_CONF | grep "^MaxKeepAliveRequests " | awk '{print $2}'`
	SERVER_TIMEOUT=`cat $APACHE_DEFAULT_CONF | grep "^Timeout " | awk '{print $2}'`

	PREFORK_START_SERVER=`echo "$PREFORK" | grep ^StartServers | awk '{print $2}'`
	PREFORK_MIN_SPARE_SERVERS=`echo "$PREFORK" | grep ^MinSpareServers | awk '{print $2}'`
	PREFORK_MAX_CLIENTS=`echo "$PREFORK" | grep ^MaxRequestWorkers | awk '{print $2}'`
	PREFORK_MAX_REQUESTS_PER_CHILD=`echo "$PREFORK" | grep ^MaxConnectionsPerChild | awk '{print $2}'`

	if [ -z $PREFORK_START_SERVER ]
		then
		if [ -f $MODULES_ENABLED_CONF_DIR/mpm_prefork.conf ]
			then

				PREFORK_START_SERVER=`cat "$MODULES_ENABLED_CONF_DIR/mpm_prefork.conf" | grep "StartServers" | grep -v "#" | awk '{print $2}'`
				PREFORK_MIN_SPARE_SERVERS=`cat "$MODULES_ENABLED_CONF_DIR/mpm_prefork.conf" | grep MinSpareServers | grep -v "#" | awk '{print $2}'`
				PREFORK_MAX_CLIENTS=`cat "$MODULES_ENABLED_CONF_DIR/mpm_prefork.conf" | grep MaxRequestWorkers | grep -v "#" | awk '{print $2}'`
				PREFORK_MAX_REQUESTS_PER_CHILD=`cat "$MODULES_ENABLED_CONF_DIR/mpm_prefork.conf" | grep MaxConnectionsPerChild | grep -v "#" | awk '{print $2}'`
		fi
	fi
	# echo $PREFORK_START_SERVER
	# echo $PREFORK_MIN_SPARE_SERVERS
	# echo $PREFORK_MAX_CLIENTS
	# echo $PREFORK_MAX_REQUESTS_PER_CHILD
	# echo $KEEP_ALIVE
	# echo $KEEP_ALIVE_TIMEOUT
	# echo $SERVER_TIMEOUT
	# echo $MAX_KEEP_ALIVE_REQUESTS
	JSON_DATA="{\"keep_alive\":\"$KEEP_ALIVE\",\"keep_alive_timeout\":\"$KEEP_ALIVE_TIMEOUT\",\"server_timeout\":\"$SERVER_TIMEOUT\",\"max_keep_alive_requests\":\"$MAX_KEEP_ALIVE_REQUESTS\",\"start_server\":\"$PREFORK_START_SERVER\",\"min_spare_servers\":\"$PREFORK_MIN_SPARE_SERVERS\",\"max_clients\":\"$PREFORK_MAX_CLIENTS\",\"max_requests_per_childs\":\"$PREFORK_MAX_REQUESTS_PER_CHILD\"}"
	echo $JSON_DATA
}
