check_command
check_root

PROC_MESSAGE=`echo "Process:$0 $@" | sed 's|["'\'']||g'`
[[ -f $PANEL_CORE_DIR/bin/debug ]] && $KWNG_LOG --debug --code=999 --message="$PROC_MESSAGE"


PROCESS="$1"

case $PROCESS in
	--joomla15)
		shift
		main_case "$@"
		joomla15_check
		joomla15_install
		;;
	--joomla17)
		shift
		main_case "$@"
		joomla17_check
		joomla17_install
		;;
	--joomla25)
		shift
		main_case "$@"
		joomla25_check
		joomla25_install
		;;
	--joomla30)
		shift
		main_case "$@"
		joomla30_check
		joomla30_install
		;;
	--wordpress)
		shift
		main_case "$@"
		wordpress_check
		wordpress_install
		;;
	--drupal)
		shift
		main_case "$@"
		drupal_check
		drupal_install
		;;
	--phpbb3)
		shift
		main_case "$@"
		phpbb3_check
		phpbb3_install
		;;
	--smf)
		shift
		main_case "$@"
		smf_check
		smf_install
		;;
	--presta)
		shift
		main_case "$@"
		presta_check
		presta_install
		;;
	--get-pkg)
		shift
		main_case "$@"
		get_package
		;;
	--get-list)
		shift
		get_list_from_apps_server
		;;
esac
