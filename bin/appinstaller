exec 2>/dev/null

function check_command() {

	KWNG_LOG="/usr/local/fpanel/core/sbin/logger"
	KWNG_ENV="/usr/local/fpanel/core/sbin/env"
	
	if [ -x "$KWNG_ENV" ]
		then
			IFS='
			'
			export `$KWNG_ENV --debug | grep -v "^#"`
			IFS=' '
		else
			$KWNG_LOG --error --code=1000 --message="Unable to set env(), please re-install packages kwng-compiler."
			exit 1000
	fi
	
	
	HTTPDOC_DIR="$APPS_DIR/httpdoc"
	DB_DIR="$APPS_DIR/databases"
	SERVER="localhost"
	
}
function check_root() {
	if [ $(id -u) -ne 0 ]
		then
			$KWNG_LOG --error --code=1001 --message="Err1001 - Tool is running without root privileges"
			exit 1001
	fi

}

function drop_all_tables() {

	ARRAY=(`mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME -e 'SHOW TABLES' | grep -v '^Tables_in' | tr ' ' ','`)
	ARRAY=`echo ${ARRAY[*]} | tr ' ' ','`
	
	mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME -e "DROP TABLE ${ARRAY};"
}

function joomla15_check() { 
	echo "check ediliyor" >> /dev/null
}
function joomla15_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
			
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc"$DIRECTORY
			JOOMLALOGDIR="$VHOSTS_DIR/$DOMAINNAME/httpdoc"$DIRECTORY
			JOOMLATMPDIR="$VHOSTS_DIR/$DOMAINNAME/httpdoc"$DIRECTORY
		else
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc"$DIRECTORY
			JOOMLALOGDIR="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc"$DIRECTORY
			JOOMLATMPDIR="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc"$DIRECTORY
	fi
	
		CONFIGURATIONFILE="$CONFIGURATIONFILE/configuration.php"
		JOOMLALOGDIR="$JOOMLALOGDIR/logs"
		JOOMLATMPDIR="$JOOMLATMPDIR/tmp"
	
	# Temizlik yapılıyor..
	if [ -z $SUBDOMAIN ]
		then
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
		else
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
	fi

	
	if [ -z $SUBDOMAIN ]
		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/ && tar -zxf $HTTPDOC_DIR/joomla15.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/ && tar -zxf $HTTPDOC_DIR/joomla15.tgz
	fi
	drop_all_tables

	cd $MYSQL_DIR/$DBNAME/ && \
		tar -zxf $DB_DIR/joomla15.tgz && \
			sed -i 's/domain.com/'"$DOMAINNAME"'/g' $MYSQL_DIR/$DBNAME/joomla15.sql && \
			sed -i 's/Welcome to the Frontpage/'"$SITENAME"'/g' $MYSQL_DIR/$DBNAME/joomla15.sql && \
			mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/joomla15.sql && \
				rm -rf joomla15.sql	
echo "<?php 
class JConfig {
/* Site Settings */
var \$offline = '0';
var \$offline_message = 'Site şu anda güncellenmektedir.<br />Lütfen daha sonra tekrar deneyiniz!';
var \$sitename = '$SITENAME';
var \$editor = 'tinymce';
var \$list_limit = '20';
var \$legacy = '0';
/* Debug Settings */
var \$debug = '0';
var \$debug_lang = '0';
/* Database Settings */
var \$dbtype = 'mysql';
var \$host = 'localhost';
var \$user = '$DBUSERNAME';
var \$password = '$DBPASSWORD';
var \$db = '$DBNAME';
var \$dbprefix = 'jos_';
/* Server Settings */
var \$live_site = '';
var \$secret = 'F36sqXUXq5eSGPJa';
var \$gzip = '0';
var \$error_reporting = '-1';
var \$helpurl = 'http://help.joomla.org';
var \$xmlrpc_server = '0';
var \$ftp_host = '127.0.0.1';
var \$ftp_port = '21';
var \$ftp_user = '$FTPUSER';
var \$ftp_pass = '$FTPPASSWD';
var \$ftp_root = '/httpdoc$DIRECTORY';
var \$ftp_enable = '1';
var \$force_ssl = '0';
/* Locale Settings */
var \$offset = '0';
var \$offset_user = '0';
/* Mail Settings */
var \$mailer = 'mail';
var \$mailfrom = '$MAILADDRESS';
var \$fromname = '$SITENAME';
var \$sendmail = '/usr/sbin/sendmail';
var \$smtpauth = '0';
var \$smtpsecure = 'none';
var \$smtpport = '25';
var \$smtpuser = '';
var \$smtppass = '';
var \$smtphost = 'localhost';
/* Cache Settings */
var \$caching = '0';
var \$cachetime = '15';
var \$cache_handler = 'file';
/* Meta Settings */
var \$MetaDesc = 'Joomla - devingen portal motoru ve içerik yönetim sistemi';
var \$MetaKeys = 'Joomla, joomla, Joomla! Türkiye';
var \$MetaTitle = '1';
var \$MetaAuthor = '1';
/* SEO Settings */
var \$sef           = '0';
var \$sef_rewrite   = '0';
var \$sef_suffix    = '0';
/* Feed Settings */
var \$feed_limit   = 10;
var \$feed_email   = 'author';
var \$log_path = '$JOOMLALOGDIR';
var \$tmp_path = '$JOOMLATMPDIR';
/* Session Setting */
var \$lifetime = '15';
var \$session_handler = 'database';
}
?>" > $CONFIGURATIONFILE
	if [ -z $SUBDOMAIN ]
		then
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/installation
		else
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/installation
	fi

	# chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*
	# mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3601 --message="Joomla 1.5 installed on $DOMAINNAME"
			exit 0
		else
			$KWNG_LOG --success --code=3601 --message="Joomla 1.5 installed on $SUBDOMAIN.$DOMAINNAME"
			exit 0
	fi

}

function wordpress_check() {
	echo "check ediliyor" >> /dev/null
}
function wordpress_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
	
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/wp-config.php"
		else
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/wp-config.php"
	fi
	# Temizlik yapılıyor..
	if [ -z $SUBDOMAIN ]
		then
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
		else
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
	fi
	


	if [ -z $SUBDOMAIN ]
		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/ && \
			tar -zxf $HTTPDOC_DIR/wordpress.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/ && \
			tar -zxf $HTTPDOC_DIR/wordpress.tgz
	fi

	drop_all_tables

	if [ -z $SUBDOMAIN ]
		then
			cd $MYSQL_DIR/$DBNAME/ && \
				tar -zxf $DB_DIR/wordpress.tgz && \
					sed -i 's/domain.com/'"$DOMAINNAME"'/g' $MYSQL_DIR/$DBNAME/wordpress.sql && \
						mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/wordpress.sql && \
							rm -rf wordpress.sql
		else
			cd $MYSQL_DIR/$DBNAME/ && \
				tar -zxf $DB_DIR/wordpress.tgz && \
					sed -i 's/www.domain.com/'"$SUBDOMAIN.$DOMAINNAME"'/g' $MYSQL_DIR/$DBNAME/wordpress.sql && \
						mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/wordpress.sql && \
							rm -rf wordpress.sql
	fi
echo "<?php
define('DB_NAME', '$DBNAME');
define('DB_USER', '$DBUSERNAME');
define('DB_PASSWORD', '$DBPASSWORD');
define('DB_HOST', 'localhost');
define('DB_CHARSET', 'utf8');
define('DB_COLLATE', '');
" > $CONFIGURATIONFILE

	wget -q -O - http://api.wordpress.org/secret-key/1.1/ >> $CONFIGURATIONFILE

echo "
\$table_prefix  = 'wp_';
define('WPLANG', '');
define('WP_DEBUG', false);
if ( !defined('ABSPATH') )
	define('ABSPATH', dirname(__FILE__) . '/');
require_once(ABSPATH . 'wp-settings.php');" >> $CONFIGURATIONFILE

	if [ -z $SUBDOMAIN ]
		then
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
		else
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY
	fi
	


	chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='http://$DOMAINNAME' WHERE option_value='http://domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='admin@$DOMAINNAME' WHERE option_value='admin@domain.com'; flush privileges" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='$SITENAME' WHERE option_value='Application'; flush privileges" $DBNAME --host=$SERVER
		else
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='http://$SUBDOMAIN.$DOMAINNAME' WHERE option_value='http://domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='admin@$DOMAINNAME' WHERE option_value='admin@domain.com'; flush privileges" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE wp_options SET option_value='$SITENAME' WHERE option_value='Application'; flush privileges" $DBNAME --host=$SERVER
	fi
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3602 --message="Wordpress installed on $DOMAINNAME"
			
		else
			$KWNG_LOG --success --code=3602 --message="Wordpress installed on $SUBDOMAIN.$DOMAINNAME"
	fi
}

