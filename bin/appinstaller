function drupal_check() {
	echo "check ediliyor" >> /dev/null
}
function drupal_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/sites/default/settings.php"
		else
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/sites/default/settings.php"
	fi
	# Temizlik yapılıyor.
	if [ -z $SUBDOMAIN ]
		then
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
		else
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
	fi
	

	if [ -z $SUBDOMAIN ]
		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY && \
				tar -zxf $HTTPDOC_DIR/drupal.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY && \
			tar -zxf $HTTPDOC_DIR/drupal.tgz
	fi
	
	if [ -z $SUBDOMAIN ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/sites/default/files/styles
		else
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/sites/default/files/styles
	fi
	
	drop_all_tables
	
	COUNTSITE=`echo $SITENAME | awk '{ print length($0) }'`
	FIXSETVARIABLE="'site_name','s:$COUNTSITE:"
	FIXVARIABLE="'site_name','s:11:"

	cd $MYSQL_DIR/$DBNAME/ && \
		tar -zxf $DB_DIR/drupal.tgz && \
			sed -i 's/Application/'"$SITENAME"'/g' $MYSQL_DIR/$DBNAME/drupal.sql && \
			sed -i 's/'"$FIXVARIABLE"'/'"$FIXSETVARIABLE"'/g' $MYSQL_DIR/$DBNAME/drupal.sql && \
			sed -i 's/domain.com/'"$DOMAINNAME"'/g' $MYSQL_DIR/$DBNAME/drupal.sql && \
			mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/drupal.sql && \
				rm -rf $MYSQL_DIR/$DBNAME/drupal.sql
				
		
echo "<?php
\$databases = array (
  'default' => 
  array (
    'default' => 
    array (
      'database' => '$DBNAME',
      'username' => '$DBUSERNAME',
      'password' => '$DBPASSWORD',
      'host' => 'localhost',
      'port' => '',
      'driver' => 'mysql',
      'prefix' => 'drupal_',
    ),
  ),
);
\$update_free_access = FALSE;
\$drupal_hash_salt = 'skhkxr36EozNjH5fYf2TUlBeIes6n1GA5oTV9gUpudg';
ini_set('session.gc_probability', 1);
ini_set('session.gc_divisor', 100);
ini_set('session.gc_maxlifetime', 200000);
ini_set('session.cookie_lifetime', 2000000);
\$conf['404_fast_paths_exclude'] = '/\/(?:styles)\//';
\$conf['404_fast_paths'] = '/\.(?:txt|png|gif|jpe?g|css|js|ico|swf|flv|cgi|bat|pl|dll|exe|asp)\$/i';
\$conf['404_fast_html'] = '<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>404 Not Found</title></head><body><h1>Not Found</h1><p>The requested URL \"@path\" was not found on this server.</p></body></html>';
" > $CONFIGURATIONFILE

	if [ -z $SUBDOMAIN ]
		then
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
		else
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY
	fi

	chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3606 --message="Drupal installed on $DOMAINNAME"
		else
			$KWNG_LOG --success --code=3606 --message="Drupal installed on $SUBDOMAIN.$DOMAINNAME"
	fi
}

function phpbb3_check() {
	echo "check ediliyor" >> /dev/null
}
function phpbb3_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc/config.php"
		else
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc/config.php"
	fi

	# Temizlik yapılıyor.
	if [ -z $SUBDOMAIN ]
		then
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
		else
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
	fi

	
	if [ -z $SUBDOMAIN ]
		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY && \
				tar -zxf $HTTPDOC_DIR/phpbb3.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/ && \
			tar -zxf $HTTPDOC_DIR/phpbb3.tgz
	fi
	drop_all_tables
	FIXSETVARIABLE="sitename','$SITENAME"
	FIXVARIABLE="sitename','yourdomain.com"
	cd $MYSQL_DIR/$DBNAME/ && \
		tar -zxf $DB_DIR/phpbb3.tgz && \
			sed -i 's/'"$FIXVARIABLE"'/'"$FIXSETVARIABLE"'/g' $MYSQL_DIR/$DBNAME/phpbb3.sql && \
			mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/phpbb3.sql && \
				rm -rf phpbb3.sql
		
echo "<?php
\$dbms = 'mysqli';
\$dbhost = 'localhost';
\$dbport = '';
\$dbname = '$DBNAME';
\$dbuser = '$DBUSERNAME';
\$dbpasswd = '$DBPASSWORD';
\$table_prefix = 'phpbb_';
\$acm_type = 'file';
\$load_extensions = '';

@define('PHPBB_INSTALLED', true);
// @define('DEBUG', true);
// @define('DEBUG_EXTRA', true);
?>" > $CONFIGURATIONFILE


	if [ -z $SUBDOMAIN ]
		then
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/install
		else
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/install
	fi

	chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	
	if [ -z $SUBDOMAIN ]
		then
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='.$DOMAINNAME' WHERE config_value='.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='www.$DOMAINNAME' WHERE config_value='www.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='www.$DOMAINNAME' WHERE config_value='www.yourdomain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='$DOMAINNAME' WHERE config_value='yourdomain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='admin@$DOMAINNAME' WHERE config_value='admin@domain.com'; flush privileges" $DBNAME --host=$SERVER
		else
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='.$SUBDOMAIN.$DOMAINNAME' WHERE config_value='.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='$SUBDOMAIN.$DOMAINNAME' WHERE config_value='www.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='$SUBDOMAIN.$DOMAINNAME' WHERE config_value='www.yourdomain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='$SUBDOMAIN.$DOMAINNAME' WHERE config_value='yourdomain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE phpbb_config SET config_value='admin@$DOMAINNAME' WHERE config_value='admin@domain.com'; flush privileges" $DBNAME --host=$SERVER
		fi
	
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3607 --message="PhpBB3 installed on $DOMAINNAME"
		else
			$KWNG_LOG --success --code=3607 --message="PhpBB3 installed on $SUBDOMAIN.$DOMAINNAME"
	fi
}

