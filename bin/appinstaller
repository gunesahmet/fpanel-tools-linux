			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE smf_settings SET value='http://$DOMAINNAME/Smileys' WHERE value='http://www.deneme.com/Smileys';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE smf_settings SET value='http://$DOMAINNAME/avatars' WHERE value='http://www.deneme.com/avatars';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE smf_themes SET value='$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/Themes/default' WHERE value='/var/www/deneme.com/httpdoc$DIRECTORY/Themes/default';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE smf_themes SET value='http://www.$DOMAINNAME/Themes/default/images' WHERE value='http://www.deneme.com/Themes/default/images';" $DBNAME --host=$SERVER
