			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/install.php
	fi
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3608 --message="SMF installed on $DOMAINNAME"
		else
			$KWNG_LOG --success --code=3608 --message="SMF installed on $SUBDOMAIN.$DOMAINNAME"
	fi
}

function presta_check() {
	echo "check ediliyor" >> /dev/null
}
function presta_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/config/settings.inc.php"
		else
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/config/settings.inc.php"
	fi
	# Temizlik yapılıyor.
	if [ -z $SUBDOMAIN ]
		then
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
		else
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
	fi


	if [ -z $SUBDOMAIN ]
		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY && \
				tar -zxf $HTTPDOC_DIR/presta.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/ && \
			tar -zxf $HTTPDOC_DIR/presta.tgz
	fi
	
CURRENT_DATE=`date +%Y-%m-%d`
CURRENT_TIME=`date +%Y-%m-%d" "%H:%M:%S`

	drop_all_tables

	cd $MYSQL_DIR/$DBNAME/ && \
		tar -zxf $DB_DIR/presta.tgz && \
			mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/presta.sql && \
				rm -rf presta.sql
		
echo "<?php
define('_DB_SERVER_', 'localhost');
define('_DB_TYPE_', 'MySQL');
define('_DB_NAME_', '$DBNAME');
define('_DB_USER_', '$DBUSERNAME');
define('_DB_PASSWD_', '$DBPASSWORD');
define('_DB_PREFIX_', 'ps_');
define('_MYSQL_ENGINE_', 'InnoDB');
define('__PS_BASE_URI__', '/');
define('_PS_CACHING_SYSTEM_', 'MCached');
define('_PS_CACHE_ENABLED_', '0');
define('_MEDIA_SERVER_1_', '');
define('_MEDIA_SERVER_2_', '');
define('_MEDIA_SERVER_3_', '');
define('_THEME_NAME_', 'prestashop');
define('_COOKIE_KEY_', 'c89JgDRk3F0D1Xy5ScCv0jcV2EKvQmkZaGLR2r1D6wtGeTIFcgF6o1Nf');
define('_COOKIE_IV_', 'MVQsiYRU');
define('_PS_CREATION_DATE_', '$CURRENT_DATE');
define('_PS_VERSION_', '1.4.8.2');
?>" > $CONFIGURATIONFILE
	chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*

	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER
	if [ -z $SUBDOMAIN ]
		then
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET date_add='$CURRENT_TIME', date_upd='$CURRENT_TIME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='$CURRENT_TIME' WHERE value='2012-06-17 20:45:13';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='http://www.$DOMAINNAME' WHERE value='http://www.yoursite.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='www.$DOMAINNAME' WHERE value='www.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_contact SET email='admin@$DOMAINNAME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_employee SET email='admin@$DOMAINNAME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='admin@$DOMAINNAME' WHERE value='info@domain.com'; flush privileges" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='$SITENAME' WHERE value='Presta Shop'; flush privileges" $DBNAME --host=$SERVER
		else
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET date_add='$CURRENT_TIME', date_upd='$CURRENT_TIME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='$CURRENT_TIME' WHERE value='2012-06-17 20:45:13';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='http://$SUBDOMAIN.$DOMAINNAME' WHERE value='http://www.yoursite.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='$SUBDOMAIN.$DOMAINNAME' WHERE value='www.domain.com';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_contact SET email='admin@$DOMAINNAME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_employee SET email='admin@$DOMAINNAME';" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='admin@$DOMAINNAME' WHERE value='info@domain.com'; flush privileges" $DBNAME --host=$SERVER
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE ps_configuration SET value='$SITENAME' WHERE value='Presta Shop'; flush privileges" $DBNAME --host=$SERVER
	fi
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER

	if [ -z $SUBDOMAIN ]
		then
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			rm -rf $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/install
		else
			chown -R $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/*
			chown $FTPUSER:$NOGROUP $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/
			rm -rf $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/install
	fi
	if [ -z $SUBDOMAIN ]
		then
			$KWNG_LOG --success --code=3609 --message="Prestashop installed on $DOMAINNAME"
		else
			$KWNG_LOG --success --code=3609 --message="Prestashop installed on $SUBDOMAIN.$DOMAINNAME"
	fi
}

function get_package() {

	if [ ! -d $HTTPDOC_DIR ]
		then
			mkdir -p $HTTPDOC_DIR >/dev/null 2>&1
	fi

	if [ ! -d $DB_DIR ]
		then
			mkdir -p $DB_DIR >/dev/null 2>&1
	fi

	for PKG_NAME in $PKG_LIST
	do
		if [ -f $HTTPDOC_DIR/$PKG_NAME.tgz ]
			then
				rm -rf $HTTPDOC_DIR/$PKG_NAME.tgz
		fi
		if [ -f $DB_DIR/$PKG_NAME.tgz ]
			then
				rm -rf $DB_DIR/$PKG_NAME.tgz
		fi

		cd $HTTPDOC_DIR && \
			wget $APPS_SERVER/httpdoc/$PKG_NAME.tgz -q

		cd $DB_DIR && \
			wget $APPS_SERVER/databases/$PKG_NAME.tgz -q
	done
	$KWNG_LOG --success --code=3610 --message="Applications downloaded"
}
function get_list_from_apps_server() {

	JSON_DATA=`echo -e "GET /xo.apps.list HTTP/1.0\nHost: $APPS_SERVER\n\n" | $NETCAT -t $APPS_SERVER 80 | tail -1`

	echo "$JSON_DATA"

}

function main_case() {
	while [ "$1" != "" ]
	do
		case $1 in
			--domain=*)
				DOMAINNAME=`echo "$1"| sed 's/--domain=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--ftp-user=*)
				FTPUSER=`echo "$1"| sed 's/--ftp-user=//g'`
				;;
			--ftp-passwd=*)
				FTPPASSWD=`echo "$1"| sed 's/--ftp-passwd=//g'`
				;;
			--dbname=*)
				DBNAME=`echo "$1"| sed 's/--dbname=//g'`
				;;
			--dbuname=*)
				DBUSERNAME=`echo "$1"| sed 's/--dbuname=//g'`
				;;
			--dbpasswd=*)
				DBPASSWORD=`echo "$1"| sed 's/--dbpasswd=//g'`
				;;
			--sitename=*)
				SITENAME=`echo "$1" | sed 's/--sitename=//g' | sed 's/#/ /g'`
				;;
			--directory=*)
				DIRECTORY=`echo "$1" | sed 's/--directory=//g'`
				;;
			--remove-content=*)
				REMOVECONTENT=`echo "$1"| sed 's/--remove-content=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--pkg-list=*)
				PKG_LIST=`echo "$1"| sed 's/--pkg-list=//g' | tr '[A-Z]' '[a-z]' | tr '#' ' '`
				;;
			--server=*)
				SERVER=`echo "$1" | sed 's/--server=//g' | tr '[A-Z]' '[a-z]' | tr ',' ' '`
				;;
			--subdomain=*)
				SUBDOMAIN=`echo "$1" | sed 's/--subdomain=//g' | tr '[A-Z]' '[a-z]'`
				;;
			--username=*)
				SITE_USERNAME=`echo "$1" | sed 's/--username=//g'`
				;;
			--password=*)
				SITE_PASSWORD=`echo "$1" | sed 's/--password=//g'`
				;;
		esac
		shift
	done
}

function usage() {
echo "Usage" > /dev/null
}

