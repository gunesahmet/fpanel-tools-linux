		then
			cd $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY && \
				tar -zxf $HTTPDOC_DIR/joomla30.tgz
		else
			cd $VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/ && \
			tar -zxf $HTTPDOC_DIR/joomla30.tgz
	fi

	drop_all_tables
	
	cd $MYSQL_DIR/$DBNAME/ && \
		tar -zxf $DB_DIR/joomla30.tgz && \
			sed -i 's/domain.com/'"$DOMAINNAME"'/g' $MYSQL_DIR/$DBNAME/joomla30.sql && \
			mysql -u $DBUSERNAME -p$DBPASSWORD $DBNAME < $MYSQL_DIR/$DBNAME/joomla30.sql && \
				rm -rf joomla30.sql
		
echo "<?php
