function joomla30_check() {
	echo "check ediliyor" >> /dev/null
}
function joomla30_install() {
	if [ ! -z $DIRECTORY ]
		then
			mkdir -p $VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY
			DIRECTORY="/$DIRECTORY"
		else
			DIRECTORY=""
	fi
	echo "Directory: " $DIRECTORY >> /tmp/wrapper.log
	if [ -z $SUBDOMAIN ]
		then
			CONFIGURATIONFILE="$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/configuration.php"
