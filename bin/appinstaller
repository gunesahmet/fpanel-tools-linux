	chown -R mysql:mysql $MYSQL_DIR/$DBNAME/*
	mysql -u $DBUSERNAME -p$DBPASSWORD -e "FLUSH PRIVILEGES;" $DBNAME --host=$SERVER

	if [ -z $SUBDOMAIN ]
		then
			mysql -u $DBUSERNAME -p$DBPASSWORD -e "UPDATE smf_settings SET value='$VHOSTS_DIR/$DOMAINNAME/httpdoc$DIRECTORY/attachments' WHERE value='/var/www/deneme.com/httpdoc$DIRECTORY/attachments';" $DBNAME --host=$SERVER
