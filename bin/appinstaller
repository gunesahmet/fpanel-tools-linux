			JOOMLALOGDIR="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/logs"
			JOOMLATMPDIR="$VHOSTS_DIR/$DOMAINNAME/subdomains/$SUBDOMAIN/httpdoc$DIRECTORY/tmp"
